---
// Responsive Shopify-CDN image: width-param srcset (CDN serves WebP/AVIF by Accept), explicit size to prevent CLS.
import { img, srcset } from '../lib/site';
interface Props { src: string; alt: string; sizes?: string; widths?: number[]; w?: number; h?: number; eager?: boolean; class?: string; style?: string; fit?: 'cover' | 'contain'; pj?: boolean; }
const { src, alt, sizes = '100vw', widths = [480, 800, 1200, 1800], w = 1600, h = 1000, eager = false, fit, style, pj = false } = Astro.props;
---
<img
  src={img(src, widths[Math.min(1, widths.length - 1)], pj)}
  srcset={srcset(src, widths, pj)} sizes={sizes} alt={alt} width={w} height={h}
  loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'auto' : 'async'} fetchpriority={eager ? 'high' : undefined}
  class={Astro.props.class} style={fit ? `object-fit:${fit};${style ?? ''}` : style}
/>
