---
// Trusted-by portraits, brand marquee and awards: shared by product and collection pages.
import { L } from '../lib/live';
import { portraits, logos } from '../lib/site';
---
<section class="tp">
  <div class="tp__h"><h2>Trusted by Those Who Inspire</h2><p>Discover how renowned personalities have integrated SUNROOOF into their spaces, bringing unparalleled lighting and ambiance to their homes and workplaces.</p></div>
  <div class="tp__s" data-tp><button type="button" class="tp__a tp__a--p" aria-label="Previous people" data-tp-prev><svg viewBox="0 0 12 20" width="9" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 1 2 10l8 9"/></svg></button><ul data-tp-track>{portraits.map(([n, r, f]) => <li><img src={L(f, 500)} width="212" height="212" alt={n} loading="lazy" /><p>{n}</p><span>{r}</span></li>)}</ul><button type="button" class="tp__a tp__a--n" aria-label="Next people" data-tp-next><svg viewBox="0 0 12 20" width="9" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m2 1 8 9-8 9"/></svg></button></div>
</section>
<section class="mq" aria-label="Brands"><div class="mq__t">{[...logos, ...logos].map(l => <img src={L(l, 300)} width="160" height="80" alt="" loading="lazy" />)}</div></section>
<section class="nd"><h2>A Nod to What We’re Building</h2><div><img src={L('good-design.png', 300)} width="102" height="102" alt="Good Design Award" loading="lazy" /><img src={L('if.png', 300)} width="102" height="102" alt="iF Design Award" loading="lazy" /></div></section>

<style>
  .tp, .mq, .nd { padding-inline: clamp(1rem, 0.5rem + 3vw, 3.25rem); }
  .tp h2, .nd h2 { font: 300 clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem)/1.2 var(--font-display); margin: 0; color: #111; }
  .tp h2, .nd h2, .rv h2, .r3 h2 { color: #111; }
  .tp { background: #fff; color: #111; padding-block: clamp(3rem, 7vw, 6rem); display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; } .tp__h { display: grid; gap: 1rem; } .tp__h h2 { max-width: 12ch; } .tp__h p { margin: 0; font-size: .75rem; max-width: 22rem; justify-self: end; text-align: right; }
  .tp__s { position: relative; max-width: 80rem; width: 100%; margin-inline: auto; } .tp ul { list-style: none; margin: 0; padding: 0 2rem; display: grid; grid-template-rows: repeat(2, auto); grid-auto-flow: column; grid-auto-columns: calc((100% - 4rem - 4 * 1rem) / 5); gap: 1.25rem 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; } .tp ul::-webkit-scrollbar { display: none; } .tp li { scroll-snap-align: start; min-width: 0; } .tp img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; filter: grayscale(1); display: block; }
  .tp li p { margin: .5rem 0 .125rem; font-size: .75rem; line-height: 1.3; color: #111; } .tp li span { display: block; font-size: .6875rem; line-height: 1.3; color: #555; }
  .tp__a { position: absolute; top: 50%; translate: 0 -50%; width: 2.75rem; height: 2.75rem; border: 0; background: none; color: #111; cursor: pointer; display: grid; place-items: center; z-index: 1; opacity: .55; transition: opacity .25s; } .tp__a:hover { opacity: 1; } .tp__a--p { left: -.75rem; } .tp__a--n { right: -.75rem; }
  .mq { background: #fff; padding-block: 1rem 3rem; overflow: hidden; } .mq__t { display: flex; gap: 5rem; width: max-content; align-items: center; animation: mq 40s linear infinite; } .mq__t img { height: 4rem; width: auto; } @keyframes mq { to { transform: translateX(-50%); } }
  .nd { background: #fff; color: #111; text-align: center; padding-block: 2rem 4rem; } .nd div { display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; } .nd img { width: 6.4rem; height: auto; }
  @media (min-width: 62rem) {
    .tp__h { grid-template-columns: 1fr 1fr; align-items: start; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tp]').forEach(box => {
    const tr = box.querySelector<HTMLElement>('[data-tp-track]')!;
    const go = (d: number) => tr.scrollBy({ left: d * (tr.clientWidth - 64), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    box.querySelector('[data-tp-prev]')!.addEventListener('click', () => go(-1)); box.querySelector('[data-tp-next]')!.addEventListener('click', () => go(1));
  });
</script>
