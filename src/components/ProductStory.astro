---
// Everything below the buy box on a product page, in the order sunrooof.com shows it.
import reviews from '../data/reviews.json';
import products from '../data/products.json';
import Pic from './Pic.astro';
import ReviewsCarousel from './ReviewsCarousel.astro';
import ReasonsCarousel from './ReasonsCarousel.astro';
import HairlineConsole from './HairlineConsole.astro';
import TrustBlock from './TrustBlock.astro';
import { L } from '../lib/live';
import { portraits, logos, inr } from '../lib/site';
interface Props { related: (typeof products)[number][]; sky: boolean; lite?: boolean; reason1?: string; }
const { related, sky, lite = false, reason1 } = Astro.props;
const stages: [string, string, string, number][] = [
  ['Booking', 'booking-icon.png', 'Clear the 1st payment milestone and we arrange a site visit to measure.', 0],
  ['Production', 'production-icon.png', 'Shop drawings come to you for approval; after approval and the 2nd milestone, we make the wooden frames.', 12],
  ['Wooden Frames', 'wooden-frame-icon.png', 'After the 3rd milestone, frames are dispatched and installed.', 43],
  ['Your Turn', 'your-turn-icon.png', 'You close the ceiling or wall with false ceiling or gypsum board and complete paint and dust-related work.', 58],
  ['Light Consoles', 'light-console-icon.png', 'When the site is dust-free and the 4th milestone is cleared, we install the consoles.', 70],
  ['Handover', 'handover-icon.png', 'We set up the automation and hand over the project.', 71],
];
const roles = ['Bollywood Actress', 'Founder of Lenskart', 'Politician', 'Bollywood Actor', 'Bollywood Movie Director', 'Interior Designer', 'Founder of Danube Properties', 'MD Dalmia Group', 'Entrepreneur & Investor', 'Owner of Good Earth'];
const remotes = products.filter(p => p.kind === 'accessory');
const arrow = '<svg viewBox="0 0 11 18" width="11" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 1l8 8-8 8"/></svg>';
---
{sky && (<>
<section class="ps lc">
  <h2>Feel the light coming from far away</h2>
  <div class="lc__pics"><img src={L('banner-before-one.png', 1200)} width="720" height="500" alt="Ordinary lighting" loading="lazy" /><img src={L('banner-after-one.png', 1200)} width="720" height="500" alt="SUNROOOF" loading="lazy" /></div>
  <div class="lc__txt">
    <div><h3>Ordinary Lighting</h3><p class="lc__k">Close to the eye | Direct | Harsh</p><p>Most regular lights are placed right on the ceiling, so you can clearly see where the light is coming from. The light feels direct, harsh, and a bit artificial; it doesn’t feel natural or comforting like sunlight.</p></div>
    <span class="lc__vs">v/s</span>
    <div><h3>SUNROOOF</h3><p class="lc__k">Feels distant like the sky | Gentle on the eyes</p><p>SUNROOOF creates a unique kind of lighting experience. You can’t see where the light is coming from; it feels like it’s coming from far above. It creates a depth effect, just like real sunlight, making the space feel bigger, softer, and more uplifting.</p></div>
  </div>
</section>

<section class="ps tl" data-timeline>
  <h2>This is How Your Project Goes</h2>
  <p class="tl__s">Hover over the stage to see detailed stages &amp; timelines</p>
  <ol class="tl__row">
    {stages.map(([n, ic, t, d], i) => (
      <li>
        <button type="button" class="tl__b" aria-label={n} aria-pressed={i === 0} data-d={d} data-n={n} data-t={t}><img src={L(ic, 200)} width="90" height="90" alt="" loading="lazy" /></button>
        <span class="tl__n">{n}</span><time class="tl__t" data-off={d}></time>
        {i < stages.length - 1 && <svg class="tl__a" viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M5 4l8 8-8 8M12 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="3"/></svg>}
      </li>
    ))}
  </ol>
  <div class="tl__card" aria-live="polite" data-card></div>
  <p class="tl__note">If you book the order today, we can deliver it by <time data-end></time>*</p>
</section>
</>)}

<TrustBlock />

<ReviewsCarousel />

{!lite && <ReasonsCarousel first={reason1} />}

<section class="ps sd" data-cmp>
  <div class="sd__h"><h2>See the Difference</h2><p>Whether creating a cozy, sunlit ambiance at home or a vibrant, well-lit workspace, SUNROOOF adapts to any environment with ease.</p></div>
  <div class="sd__c"><img class="sd__a" src={L('after-image.png', 1800)} width="1440" height="700" alt="With SUNROOOF" loading="lazy" /><div class="sd__clip"><img src={L('before-image.png', 1800)} width="1440" height="700" alt="Without SUNROOOF" loading="lazy" /></div><span class="sd__h2" aria-hidden="true">‹ ›</span><input class="sd__r" type="range" min="0" max="100" value="50" aria-label="Compare before and after" /></div>
</section>

{!lite && sky && <HairlineConsole />}
{!lite && <>
<section class="ps ap">
  <div class="ap__h"><h2>Control The SUNROOOF<br />With Mobile App</h2><p>SUNROOOF by default is controlled by an app. App Setup is complimentary when you buy any SUNROOOF. However, for ease of access, you can choose to buy additional remote accessories for your SUNROOOF.</p></div>
  <div class="ap__b">
    <img src={L('mob-app-image.png', 700)} width="320" height="640" alt="The SUNROOOF app" loading="lazy" />
    <div><h3>Get SUNROOOF Advanced Remote</h3><p>SUNROOOF by default is controlled by an app. App setup is complimentary when you buy any SUNROOOF.</p>
      <ul>{remotes.map(r => <li><a href={`/products/${r.handle}`}><Pic pj src={r.images[0]} alt={r.title} widths={[300, 500]} sizes="220px" w={300} h={300} fit="contain" /><span>{r.title}</span><b>{inr(r.from)}</b></a></li>)}</ul></div>
  </div>
</section>

<section class="ps pt">
  <img src={L('Frame_37.png', 900)} width="540" height="540" alt="Patent drawing of the SUNROOOF console frame" loading="lazy" />
  <div><h2>We hold a patent<br />for what we create</h2><p>Innovation is at the heart of everything we do. Our patented technology ensures that every product we create stands apart built with originality, precision, and purpose.</p><p>This patent isn’t just a recognition; it’s proof of our commitment to excellence and authenticity. What we make is uniquely ours, protected by innovation and trusted by our customers.</p><a class="pt__b" href="https://cdn.shopify.com/s/files/1/0693/8270/1216/files/SUNROOOF_patent.pdf?v=1762330349" target="_blank" rel="noopener">Download The Patent</a></div>
</section>

<section class="ps sc"><img src={L('Frame_1.png', 300)} width="60" height="60" alt="" loading="lazy" /><h2>Still Confused? Need Customization?<br />We’re Happy to Help You</h2><a href="/pages/contact-us" data-lead>Contact us</a></section>
</>}

{related.length > 0 && (
<section class="ps rl">
  <h2>Related SUNROOOF</h2>
  <ul>{related.map(r => <li><a href={`/products/${r.handle}`}><Pic pj src={r.images[0]} alt={r.title} widths={[400, 700]} sizes="(min-width: 62rem) 24vw, 92vw" w={700} h={700} /><b>{r.title}</b></a></li>)}</ul>
</section>
)}

<style>
  .ps { padding-inline: clamp(1rem, 0.5rem + 3vw, 3.25rem); color: #fff; background: #121212; }
  .ps h2 { font: 300 clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem)/1.2 var(--font-display); margin: 0; }
  .ps h3 { font: 300 1.75rem/1.2 var(--font-display); margin: 0; }
  .lc { padding-block: clamp(3rem, 7vw, 6rem); } .lc h2 { max-width: 15ch; margin-bottom: 2rem; }
  .lc__pics { display: grid; gap: .75rem; margin-inline: calc(clamp(1rem, 0.5rem + 3vw, 3.25rem) * -1); } .lc__pics img { width: 100%; height: auto; display: block; }
  .lc__txt { display: grid; gap: 2rem; padding-top: 2rem; align-items: start; } .lc__txt p { margin: .75rem 0 0; font-size: .875rem; line-height: 1.5; max-width: 28rem; } .lc__txt .lc__k { color: var(--sun); font-weight: 700; text-transform: uppercase; font-size: .8125rem; margin-top: 1.25rem; } .lc__vs { font: 300 1.5rem var(--font-display); text-align: center; }
  .tl { padding-block: clamp(3rem, 7vw, 6rem); text-align: center; } .tl__s { font-size: .875rem; margin: 1rem 0 3rem; }
  .tl__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 0; }
  .tl__row li { position: relative; display: grid; justify-items: center; gap: .5rem; }
  .tl__b { width: 5.5rem; height: 5.5rem; border-radius: 50%; padding: 0; background: rgb(255 201 51 / .14); border: 1px solid transparent; cursor: pointer; display: grid; place-items: center; transition: border-color .3s, background .3s; } .tl__b img { width: 55%; height: auto; opacity: .55; transition: opacity .3s; }
  .tl__b[aria-pressed=true], .tl__b:hover { border-color: var(--sun); background: rgb(255 201 51 / .08); } .tl__b[aria-pressed=true] img, .tl__b:hover img { opacity: 1; }
  .tl__n { font-size: .6875rem; text-transform: uppercase; color: rgb(255 201 51 / .6); } .tl__t { font-size: .75rem; color: rgb(255 255 255 / .75); }
  .tl__a { position: absolute; right: -1.1rem; top: 1.9rem; color: var(--sun); display: none; }
  .ap, .ap__b, .pt, .sd, .lc__txt, .rv { grid-template-columns: minmax(0, 1fr); } .ap__b > div, .pt > div { min-width: 0; } .ap__b h3 { overflow-wrap: anywhere; }
  .tl__card { width: min(26rem, 100%); margin: 2rem auto 0; padding: 1rem; border: 1px solid rgb(255 201 51 / .45); background: rgb(255 201 51 / .06); text-align: left; font-size: .8125rem; line-height: 1.5; } .tl__hd { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .5rem; } .tl__card b { color: var(--sun); text-transform: uppercase; } .tl__card p { margin: 0; }
  .tl__note { margin: 3rem 0 0; font-style: italic; color: var(--sun); font-size: .8125rem; }
  .rv { background: #fff; color: #111; padding-block: clamp(2.5rem, 5vw, 4rem); display: grid; gap: 1.5rem; } .rv__h p { margin: 0 0 .5rem; color: #6b6b6b; } .rv__h h2 { font-size: 1.5rem; max-width: 12ch; }
  .rv__n { display: flex; gap: 1rem; margin-top: 1.5rem; } .rv__n button { background: none; border: 0; cursor: pointer; color: #111; padding: .5rem; }
  .rv__t { display: grid; grid-auto-flow: column; grid-auto-columns: min(100%, 38rem); gap: 2rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; } .rv__t blockquote { margin: 0; scroll-snap-align: start; } .rv__t p { margin: 0 0 1.25rem; font: 400 clamp(1.125rem, 1rem + .6vw, 1.625rem)/1.35 var(--font-body); } .rv__t footer { font-size: .9375rem; }
  .sd { color: #111; background: linear-gradient(#f2de86, #fbe05a 55%, #f4c455); padding-block: clamp(3rem, 6vw, 5rem) 1rem; display: grid; gap: 2rem; } .sd__h { display: grid; gap: 1rem; } .sd__h p { margin: 0; font-size: .75rem; max-width: 22rem; } .sd .sd__h h2 { color: #111; }
  .sd__c { position: relative; aspect-ratio: 1440 / 700; overflow: hidden; --pos: 50%; } .sd__c img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; } .sd__clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); } .sd__clip img { position: absolute; }
  .sd__h2 { position: absolute; top: 50%; left: var(--pos); translate: -50% -50%; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--sun); display: grid; place-items: center; font-size: .875rem; color: #111; box-shadow: 0 0 0 2px #fff; pointer-events: none; }
  .sd__c::after { content: ''; position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; background: #fff; translate: -1px; pointer-events: none; } .sd__r { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
  .ap { color: #111; background: linear-gradient(#f4c455, #e9a64a 55%, #a56d36); padding-block: clamp(3rem, 6vw, 5rem); display: grid; gap: 2rem; } .ap h2 { color: #111; } .ap__h p { margin: 1rem 0 0; font-size: .75rem; max-width: 24rem; }
  .ap__b { display: grid; gap: 2rem; align-items: center; } .ap__b > img { width: min(100%, 19rem); height: auto; justify-self: center; } .ap__b h3 { font-size: 1.5rem; color: #111; } .ap__b p { margin: .5rem 0 1.5rem; font-size: .75rem; max-width: 22rem; }
  .ap ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; overflow-x: auto; scrollbar-width: none; } .ap li { flex: 0 0 11rem; } .ap li a { display: grid; gap: .5rem; color: #111; text-decoration: none; font-size: .9375rem; } .ap li img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
  .pt { background: linear-gradient(#a56d36, #2b1d12 30%, #0e0e0e 70%); display: grid; gap: 2rem; padding-block: clamp(3rem, 6vw, 5rem) 3rem; align-items: center; } .pt > img { width: 100%; max-width: 33rem; height: auto; background: #fff; } .pt h2 { font-size: clamp(2rem, 1.4rem + 2vw, 3.25rem); margin-bottom: 1.5rem; } .pt p { font-size: .75rem; line-height: 1.55; max-width: 24rem; margin: 0 0 1rem; }
  .pt__b { display: inline-block; margin-top: .75rem; padding: .75rem 1rem; border: 1px solid rgb(255 255 255 / .6); color: #fff; text-decoration: none; font-size: .75rem; } .pt__b:hover { border-color: var(--sun); color: var(--sun); }
  .sc { text-align: center; padding-block: 3rem; display: grid; justify-items: center; gap: 1.25rem; } .sc img { width: 3.75rem; height: auto; } .sc h2 { color: var(--sun); font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); } .sc a { color: #fff; text-decoration: none; text-transform: uppercase; font-size: .8125rem; border-bottom: 1px solid var(--sun); padding: .5rem .25rem; } .sc a:hover { color: var(--sun); }
  .rl { padding-block: 3rem clamp(3rem, 7vw, 6rem); } .rl h2 { margin-bottom: 2rem; } .rl ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); } .rl a { display: grid; gap: .5rem; color: #fff; text-decoration: none; } .rl img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; background: #3d3d3d; } .rl b { font: 400 1.0625rem/1.2 var(--font-display); text-transform: uppercase; } .rl span { font-size: .75rem; text-transform: uppercase; } .rl b { font: 300 .9375rem/1.2 var(--font-display); text-transform: uppercase; }
  @media (min-width: 62rem) {
    .lc__pics { grid-template-columns: 1fr 1fr; } .lc__txt { grid-template-columns: 1fr auto 1fr; } .lc__txt > div:first-child { padding-left: 0; } .lc__vs { padding-top: .25rem; }
    .tl__row { grid-template-columns: repeat(6, 1fr); } .tl__a { display: block; }
    .sd__h { grid-template-columns: 1fr 1fr; align-items: end; } .sd__h p { justify-self: end; }
    .ap__b { grid-template-columns: 1fr 1.4fr; } .ap { padding-inline: clamp(1rem, 0.5rem + 3vw, 3.25rem); } .ap__h { display: grid; grid-template-columns: 1fr 1fr; align-items: end; } .ap__h p { justify-self: end; }
    .pt { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  // Timeline: dates are counted from today; hover or tap a stage for its detail.
  const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
  const at = (n: number) => { const d = new Date(); d.setDate(d.getDate() + n); return d; };
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    tl.querySelectorAll<HTMLElement>('time[data-off]').forEach(t => (t.textContent = fmt(at(Number(t.dataset.off)))));
    tl.querySelector<HTMLElement>('time[data-end]')!.textContent = fmt(at(71));
    const card = tl.querySelector<HTMLElement>('[data-card]')!, btns = [...tl.querySelectorAll<HTMLButtonElement>('.tl__b')];
    const show = (b: HTMLButtonElement) => { btns.forEach(x => x.setAttribute('aria-pressed', String(x === b))); const d = Number(b.dataset.d); card.innerHTML = `<div class="tl__hd"><b>${b.dataset.n}</b><span>${fmt(at(d))}</span></div><p>${b.dataset.t}</p>`; };
    btns.forEach(b => { b.addEventListener('mouseenter', () => show(b)); b.addEventListener('focus', () => show(b)); b.addEventListener('click', () => show(b)); });
    show(btns[0]);
  }
  // Reviews: arrows scroll the track one review at a time.
  const rv = document.querySelector<HTMLElement>('[data-rv]');
  if (rv) { const tr = rv.querySelector<HTMLElement>('[data-rv-track]')!; rv.querySelector('[data-rv-prev]')!.addEventListener('click', () => tr.scrollBy({ left: -tr.clientWidth, behavior: 'smooth' })); rv.querySelector('[data-rv-next]')!.addEventListener('click', () => tr.scrollBy({ left: tr.clientWidth, behavior: 'smooth' })); }
  // Before/after slider.
  document.querySelectorAll<HTMLElement>('[data-cmp] .sd__c').forEach(c => { const r = c.querySelector<HTMLInputElement>('.sd__r')!; const set = () => c.style.setProperty('--pos', `${r.value}%`); r.addEventListener('input', set); set(); });
</script>
