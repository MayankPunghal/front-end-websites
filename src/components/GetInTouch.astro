---
// "Get in Touch with Us": the inline call-back form shared by contact, about and clients pages (as on sunrooof.com).
// Same endpoint, method and field names as the live form (src/data/form.json); posted in the background so the page stays put.
import form from '../data/form.json';
import { SITE } from '../lib/site';
interface Props { id?: string; page?: boolean; }
const { id = 'git', page = false } = Astro.props;
const S = form.selects as Record<string, { label: string; options: string[] }>;
const selects = ['which_best_describes_you', 'Lead_Type', 'How_many_spaces_are_you_considering', 'Project_Stage', 'Timeline_for_Installing_SUNROOOF', 'state'];
const clean = (l: string) => l.replace(/Sunrooof/g, 'SUNROOOF');
const text: [string, string, string, string][] = [['city', 'City', 'text', 'address-level2'], ['Name', 'Name', 'text', 'name'], ['mobile', 'Mobile Number', 'tel', 'tel-national'], ['email', 'Email', 'email', 'email']];
---
<section class:list={['gt', { 'gt--page': page }]} aria-labelledby={`${id}-h`}>
  <div class="gt__in">
    <div class="gt__head">
      {page ? <h4 id={`${id}-h`}>Request a call back</h4> : <h2 id={`${id}-h`}>Get in Touch with Us</h2>}
      <p>Fill out the form and our specialist will contact you as soon as possible</p>
    </div>
    <form class="gt__form" method="post" action={SITE.formEndpoint} enctype="multipart/form-data" target={`${id}-frame`} novalidate data-git>
      {selects.map(name => (
        <div class="field">
          <select name={name} aria-label={clean(S[name].label)} required>
            <option value="" disabled selected>{clean(S[name].label)} *</option>
            {S[name].options.map(o => <option value={o}>{o}</option>)}
          </select>
          <p class="err" role="alert"></p>
        </div>
      ))}
      {text.map(([name, ph, type, ac]) => (
        <div class="field">
          <input name={name} type={type} placeholder={ph} aria-label={ph} autocomplete={ac} required pattern={type === 'tel' ? '[0-9 +()\\-]{8,16}' : undefined} inputmode={type === 'tel' ? 'numeric' : undefined} />
          <p class="err" role="alert"></p>
        </div>
      ))}
      <div class="field">
        <label for={`${id}-file`}>Upload the layout for your space where you want SUNROOOF <small>(PNG, JPEG or PDF - MAX 10 MB)</small></label>
        <input id={`${id}-file`} name="Upload_File" type="file" accept=".png,.jpg,.jpeg,.pdf" data-max-mb="10" />
        <p class="err" role="alert"></p>
      </div>
      <div class="field"><textarea name="specify_the_area_in_the_layout_where_you_want_the_sunroof" rows="3" placeholder="Specify the area in the layout where you want the SUNROOOF" aria-label="Area of the layout"></textarea></div>
      <button class="gt__btn" type="submit">Request a call back</button>
      <p class="gt__msg" role="status" data-msg></p>
    </form>
    <iframe name={`${id}-frame`} title="Form submission" hidden tabindex="-1"></iframe>
  </div>
</section>

<style is:global>
  .gt { background: #121212; color: #fff; padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); }
  .gt__in { display: grid; gap: 2.5rem; align-items: center; }
  .gt__head h2 { font: 300 clamp(2rem, 1.4rem + 1.6vw, 2.5rem)/1.2 var(--font-display); margin: 0 0 1rem; }
  .gt__head h4 { font: 400 1.5rem/1.2 var(--font-body); color: rgb(255 255 255 / .6); margin: 0 0 1rem; text-transform: uppercase; }
  .gt__head p { margin: 0; font-size: .8125rem; text-transform: uppercase; max-width: 22rem; line-height: 1.5; }
  .gt__form { display: grid; gap: .5rem; max-width: 46rem; }
  .gt .field { display: grid; }
  .gt .field > input:not([type=file]), .gt .field textarea { width: 100%; min-height: 3rem; padding: .5rem .375rem; background: transparent; border: 0; border-bottom: 1px solid rgb(157 159 161 / .75); border-radius: 0; color: #fff; font: inherit; font-size: 1rem; }
  .gt .field textarea { min-height: 4.5rem; resize: vertical; }
  .gt .field input::placeholder, .gt .field textarea::placeholder { color: #9d9fa1; opacity: 1; }
  .gt .field input:focus, .gt .field textarea:focus { outline: 0; border-bottom-color: var(--sun); }
  .gt .ui-select { --ink: #fff; --ink-3: #9d9fa1; --paper-2: #1b1b1b; --line: rgb(255 255 255 / .25); }
  .gt .ui-select__btn { min-height: 3rem; padding: .5rem 2rem .5rem .375rem; font-size: 1rem; border-width: 0 0 1px; border-color: rgb(157 159 161 / .75); }
  .gt .ui-select__btn::placeholder { color: #9d9fa1; }
  .gt .ui-select__list li { font-size: .9375rem; }
  .gt .field > label { display: grid; gap: .25rem; padding: 1rem .375rem .25rem; color: #9d9fa1; font-size: .9375rem; } .gt .field > label small { font-size: .625rem; text-transform: uppercase; }
  .gt .field input[type=file] { color: #fff; padding: .5rem .375rem; font-size: .875rem; border-bottom: 1px solid rgb(157 159 161 / .75); }
  .gt .field input[type=file]::file-selector-button { margin-right: .75rem; padding: .25rem .625rem; background: #2a2a2a; color: #fff; border: 0; border-radius: 3px; font: inherit; font-size: .75rem; cursor: pointer; }
  .gt .err { margin: .25rem 0 0; padding-inline: .375rem; color: #ff9a80; font-size: .8125rem; } .gt .err:empty { display: none; }
  .gt__btn { justify-self: center; margin-top: 1.5rem; padding: .75rem .75rem .625rem; background: none; border: 0; border-bottom: 1px solid var(--sun); color: #fff; font: inherit; font-size: .9375rem; text-transform: uppercase; cursor: pointer; transition: color .3s; }
  .gt__btn:hover { color: var(--sun); }
  .gt__msg { justify-self: center; margin: .5rem 0 0; min-height: 1.5rem; font-size: .9375rem; text-align: center; }
  @media (min-width: 62rem) {
    .gt__in { grid-template-columns: 1fr 1.15fr; gap: clamp(3rem, 6vw, 7rem); } .gt__form { justify-self: end; width: 100%; }
    .gt--page .gt__in { grid-template-columns: 1.1fr 1.2fr 2.1fr; align-items: start; gap: 2rem; } .gt--page .gt__head { display: contents; }
    .gt--page .gt__head p { grid-column: 2; grid-row: 1; padding-top: .25rem; } .gt--page .gt__head h4 { grid-column: 1; grid-row: 1; margin: 0; }
    .gt--page .gt__form { grid-column: 3; grid-row: 1; } .gt--page .gt__in > iframe { display: none; }
  }
</style>

<script>
  // Client-side validation, then a background POST to the existing endpoint (native form submit into the hidden iframe).
  const MSG: Record<string, string> = { valueMissing: 'This is required.', typeMismatch: 'Enter a valid value.', patternMismatch: 'Enter a valid number.' };
  document.querySelectorAll<HTMLFormElement>('[data-git]').forEach(form => {
    const msg = form.querySelector<HTMLElement>('[data-msg]')!, frame = form.parentElement!.querySelector('iframe')!;
    let sent = false;
    const setErr = (host: Element | null, t: string) => { const e = host?.querySelector<HTMLElement>('.err'); if (e) e.textContent = t; };
    const check = () => {
      let first: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required], select[required]').forEach(el => {
        const bad = !el.checkValidity();
        setErr(el.closest('.field'), bad ? MSG[Object.keys(MSG).find(k => (el.validity as any)[k]) ?? 'valueMissing'] : '');
        if (bad) first ??= (el.closest('.field')?.querySelector<HTMLElement>('.ui-select__btn') ?? el);
      });
      const f = form.querySelector<HTMLInputElement>('input[type=file]');
      if (f?.files?.[0] && f.files[0].size > Number(f.dataset.maxMb) * 1048576) { setErr(f.closest('.field'), `The file is over ${f.dataset.maxMb} MB. Choose a smaller one.`); first ??= f; } else if (f) setErr(f.closest('.field'), '');
      return first;
    };
    form.addEventListener('submit', e => { const bad = check(); if (bad) { e.preventDefault(); msg.textContent = 'Some details are missing. Please fix the highlighted fields.'; bad.focus(); } else { msg.textContent = 'Sending…'; sent = true; } });
    form.addEventListener('change', () => { if (msg.textContent) check(); });
    frame.addEventListener('load', () => { if (sent) { msg.textContent = 'Thank you. A SUNROOOF specialist will call you back as soon as possible.'; form.reset(); sent = false; } });
  });
</script>
