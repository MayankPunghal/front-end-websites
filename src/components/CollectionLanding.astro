---
// A product-family page as on sunrooof.com: full-width banner, details, before/after, social proof, video, wellness, similar families.
import pages from '../data/collection-pages.json';
import products from '../data/products.json';
import TrustBlock from './TrustBlock.astro';
import ReviewsCarousel from './ReviewsCarousel.astro';
import FaqBlock from './FaqBlock.astro';
import { COLLECTIONS } from '../lib/site';
interface Props { handle: string; }
const { handle } = Astro.props;
const c = (pages as Record<string, (typeof pages)['arch-window']>)[handle];
const col = COLLECTIONS.find(x => x.handle === handle)!;
const list = products.filter(p => p.family === col.family);
const [after, before] = c.cmp;
const pause = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M3.5 2h3v12h-3zM9.5 2h3v12h-3z"/></svg>';
---
<h1 class="sr-only">{col.title} SUNROOOF</h1>
<section class="cl-b">
  <img class="cl-b__d" src={`${c.banner}?width=1800`} width="1440" height="900" alt={`${col.title} SUNROOOF fitted in a room`} fetchpriority="high" />
  <img class="cl-b__m" src={`${c.bannerM}?width=900`} width="720" height="900" alt="" />
  <ul class="cl-b__p" aria-label={`${col.title} models`}>
    {list.map(p => <li><a href={`/products/${p.handle}`}><span>{p.title}</span><i>View details</i></a></li>)}
  </ul>
</section>

<section class="cl-d">
  <h2>{c.title}</h2>
  <p>{c.desc}</p>
  <div class="cl-d__i">{c.det.map(u => <img src={`${u}?width=900`} width="600" height="720" alt="" loading="lazy" />)}</div>
</section>

<section class="cl-s" data-cmp>
  <div class="cl-s__h"><h2>Make any space Sunlit</h2><p>Whether creating a cozy, sunlit ambiance at home or a vibrant, well-lit workspace, SUNROOOF adapts to any environment with ease.</p></div>
  <div class="cl-s__c"><img class="cl-s__a" src={`${after}?width=1800`} width="1440" height="740" alt="With SUNROOOF" loading="lazy" /><div class="cl-s__clip"><img src={`${before}?width=1800`} width="1440" height="740" alt="Without SUNROOOF" loading="lazy" /></div><span class="cl-s__k" aria-hidden="true">‹ ›</span><input class="cl-s__r" type="range" min="0" max="100" value="50" aria-label="Compare before and after" /></div>
</section>

<TrustBlock />
<ReviewsCarousel />

<section class="cl-p">
  <div class="cl-p__h"><h2>Personalize it &amp; Make it yours</h2><a href="/pages/contact-us" data-lead data-prefill={`I would like a quote for ${col.title}.`}>Get quote</a></div>
  <figure class="cl-p__v" data-cl-video>
    <video src={`${c.video}.mp4`} poster={`${c.video}.jpg`} muted loop playsinline preload="none" aria-label="Colours and brightness change like the sky"></video>
    <figcaption>Changes colours &amp; brightness just like the sky</figcaption>
    <button type="button" aria-label="Pause video" data-cl-toggle set:html={pause}></button>
  </figure>
</section>

<section class="cl-w" style="--bg:url('https://sunrooof.com/cdn/shop/files/bg-desktop.png')">
  <h2>with proven wellness</h2>
  <div class="cl-w__a"><h3>Elevate Mood</h3><p>SUNROOOF creates a calming, stress-free environment, enhancing relaxation and positivity—just like natural sunlight.</p></div>
  <div class="cl-w__b"><h3>Improves Focus</h3><p>SUNROOOF enhances serotonin levels, sharpening focus and mental clarity—keeping you engaged and productive throughout the day.</p></div>
</section>

<section class="cl-r">
  <h2>Similar Products</h2>
  <ul>{c.sim.map(s => <li><a href={s.href} data-plx><img src={`${s.img}?width=1000`} width="700" height="520" alt={s.href.split('/').pop()!.replace(/-sunrooof$/, '').replace(/-/g, ' ')} loading="lazy" /></a></li>)}</ul>
</section>

<FaqBlock />

<style>
  .cl-b { position: relative; background: #ddd; }
  .cl-b img { display: block; width: 100%; height: calc(100svh - 4.5rem); min-height: 28rem; object-fit: cover; } .cl-b__m { display: none !important; }
  .cl-b__p { position: absolute; right: clamp(1rem, 3vw, 3rem); bottom: clamp(1rem, 3vw, 2.5rem); margin: 0; padding: 0; list-style: none; display: grid; gap: .5rem; }
  .cl-b__p a { display: grid; gap: .125rem; min-width: 14rem; padding: .875rem 1.125rem; background: rgb(17 17 17 / .78); color: #fff; text-decoration: none; backdrop-filter: blur(8px); transition: background .3s; } .cl-b__p a:hover { background: #111; }
  .cl-b__p span { text-transform: uppercase; font-size: .8125rem; } .cl-b__p b { font: 400 1.125rem/1.2 var(--font-display); } .cl-b__p i { font-style: normal; font-size: .75rem; text-transform: uppercase; color: var(--sun); }
  .cl-d { background: #e3dab9; color: #111; padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); display: grid; gap: 1.5rem; }
  .cl-d h2 { font: 300 clamp(1.75rem, 1.2rem + 2vw, 3rem)/1.15 var(--font-display); margin: 0; max-width: 11ch; color: #111; } .cl-d p { margin: 0; font-size: .75rem; line-height: 1.55; max-width: 22rem; }
  .cl-d__i { display: grid; grid-template-columns: 1fr; gap: .75rem; margin-top: 1rem; } .cl-d__i img { width: 100%; height: auto; display: block; }
  .cl-s { background: linear-gradient(#f2de86, #fbe05a 55%, #f4c455); color: #111; padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); display: grid; gap: 2rem; }
  .cl-s h2 { font: 300 clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem)/1.2 var(--font-display); margin: 0; color: #111; } .cl-s__h p { margin: 1rem 0 0; font-size: .75rem; max-width: 22rem; }
  .cl-s__c { position: relative; aspect-ratio: 1440 / 740; overflow: hidden; --pos: 50%; } .cl-s__c img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; } .cl-s__clip { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .cl-s__k { position: absolute; top: 50%; left: var(--pos); translate: -50% -50%; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--sun); display: grid; place-items: center; font-size: .875rem; box-shadow: 0 0 0 2px #fff; pointer-events: none; }
  .cl-s__c::after { content: ''; position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; background: #fff; translate: -1px; pointer-events: none; } .cl-s__r { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
  .cl-p { background: #121212; color: #fff; padding: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); text-align: center; }
  .cl-p__h { display: grid; gap: 1rem; justify-items: center; margin-bottom: 2rem; } .cl-p h2 { font: 300 clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem)/1.2 var(--font-display); margin: 0; }
  .cl-p__h a { color: #fff; text-transform: uppercase; font-size: .75rem; text-decoration: none; border-bottom: 1px solid var(--sun); padding: .5rem .25rem; } .cl-p__h a:hover { color: var(--sun); }
  .cl-p__v { position: relative; margin: 0 auto; max-width: 72rem; aspect-ratio: 16 / 9; background: #000; overflow: hidden; } .cl-p__v video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cl-p__v figcaption { position: absolute; left: clamp(1rem, 3vw, 2rem); bottom: clamp(1rem, 3vw, 2rem); right: 4rem; text-align: left; font: 300 clamp(1.125rem, 1rem + .8vw, 1.75rem)/1.2 var(--font-display); text-shadow: 0 1px 14px rgb(0 0 0 / .5); }
  .cl-p__v button { position: absolute; left: 50%; bottom: 1rem; translate: -50% 0; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 0; background: rgb(17 17 17 / .55); color: #fff; display: grid; place-items: center; cursor: pointer; } .cl-p__v button:hover { background: rgb(17 17 17 / .85); }
  .cl-w { position: relative; min-height: clamp(34rem, 52vw, 46rem); background: linear-gradient(#121212, rgb(18 18 18 / 0) 18%), var(--bg) center / cover no-repeat, #a9c2cf; color: #111; padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); display: grid; gap: 2rem; align-content: space-between; }
  .cl-w h2 { font: 300 clamp(2rem, 1.2rem + 3vw, 3.5rem)/1.1 var(--font-display); text-align: center; margin: 0; color: #fff; text-shadow: 0 2px 24px rgb(0 0 0 / .25); }
  .cl-w h3 { font: 300 clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem)/1.2 var(--font-display); margin: 0 0 .5rem; color: #111; } .cl-w p { margin: 0; font-size: .875rem; line-height: 1.5; max-width: 22rem; color: #111; }
  .cl-w__b { justify-self: end; }
  .cl-r { background: #121212; color: #fff; padding: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); } .cl-r h2 { font: 300 clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem)/1.2 var(--font-display); margin: 0 0 1.5rem; }
  .cl-r ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; grid-template-columns: 1fr; } .cl-r a { display: block; overflow: hidden; } .cl-r img { width: 100%; height: auto; display: block; }
  @media (min-width: 48rem) { .cl-d { grid-template-columns: 1fr 1fr; align-items: start; } .cl-d__i { grid-column: 1 / -1; grid-template-columns: repeat(3, 1fr); } .cl-r ul { grid-template-columns: repeat(2, 1fr); } .cl-s__h { display: grid; grid-template-columns: 1fr 1fr; align-items: end; } .cl-s__h p { justify-self: end; } }
  @media (max-width: 47.99rem) { .cl-b__d { display: none !important; } .cl-b__m { display: block !important; } .cl-b__p { position: static; padding: .75rem; background: #121212; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cmp] .cl-s__c').forEach(c => { const r = c.querySelector<HTMLInputElement>('.cl-s__r')!; const set = () => c.style.setProperty('--pos', `${r.value}%`); r.addEventListener('input', set); set(); });
  const fig = document.querySelector<HTMLElement>('[data-cl-video]');
  if (fig) {
    const v = fig.querySelector('video')!, btn = fig.querySelector<HTMLButtonElement>('[data-cl-toggle]')!; let held = matchMedia('(prefers-reduced-motion: reduce)').matches, seen = false;
    const run = () => { if (seen && !held) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause(); };
    const icon = (p: boolean) => (btn.innerHTML = p ? '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M4 2.5v11l9-5.5z"/></svg>' : '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M3.5 2h3v12h-3zM9.5 2h3v12h-3z"/></svg>');
    icon(held); btn.setAttribute('aria-label', held ? 'Play video' : 'Pause video');
    btn.addEventListener('click', () => { held = !held; icon(held); btn.setAttribute('aria-label', held ? 'Play video' : 'Pause video'); run(); });
    new IntersectionObserver(es => { seen = es[0].isIntersecting; run(); }, { threshold: 0.4 }).observe(fig);
  }
</script>
