---
// Products grid as on sunrooof.com: three columns, serif product names, "From ₹ x to ₹ y", Book now.
import Pic from './Pic.astro';
import FaqBlock from './FaqBlock.astro';
import ProductStory from './ProductStory.astro';
import products from '../data/products.json';
import { COLLECTIONS, inr } from '../lib/site';

interface Props { handle: string; }
const { handle } = Astro.props;
const col = COLLECTIONS.find(c => c.handle === handle);
const list = [...(col ? products.filter(p => p.family === col.family) : products)].sort((a, b) => a.title.localeCompare(b.title));
const price = (p: (typeof products)[number]) => { const v = p.variants.map(x => x.price); const lo = Math.min(...v), hi = Math.max(...v); return lo === hi ? inr(lo) : `From ${inr(lo)} to ${inr(hi)}`; };
---
<h1 class="pg__h">{col ? col.title : 'Products'}</h1>
<ul class="pg">
  {list.map(p => (
    <li data-reveal>
      <a href={`/products/${p.handle}`} class="pg__m" data-plx={p.kind !== 'accessory' || undefined}><Pic pj class="pg__i" src={p.images[0]} alt={p.title} widths={[400, 700, 1000]} sizes="(min-width: 62rem) 30vw, 92vw" w={1000} h={1000} fit={p.kind === 'accessory' ? 'contain' : 'cover'} /></a>
      <h2><a href={`/products/${p.handle}`}>{p.title}</a></h2>
      <p>{price(p)}</p>
      <a class="pg__b" href={`/products/${p.handle}`}>Book now</a>
    </li>
  ))}
</ul>
{col && <ProductStory lite sky={false} related={products.filter(p => p.family !== col.family && p.kind !== 'accessory').slice(0, 3)} />}
<FaqBlock />

<style>
  .pg__h { font: 300 clamp(2.25rem, 1.6rem + 1.6vw, 2.5rem)/1.2 var(--font-display); margin: 0; padding: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem) clamp(1.5rem, 3vw, 2.5rem); color: #fff; }
  .pg { list-style: none; margin: 0; padding: 0 clamp(1rem, 0.5rem + 3vw, 3.25rem) clamp(4rem, 9vw, 8rem); display: grid; gap: 3rem 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); color: #fff; }
  .pg__m { display: block; aspect-ratio: 1; background: #3d3d3d; overflow: hidden; }
  .pg__i { width: 100%; height: 100%; display: block; }
  .pg h2 { font: 400 1.125rem/1.2 var(--font-display); text-transform: uppercase; margin: 1rem 0 .5rem; } .pg h2 a { color: #fff; text-decoration: none; }
  .pg p { margin: 0 0 .75rem; font-size: .75rem; text-transform: uppercase; }
  .pg__b { color: #fff; font-size: .75rem; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid #fff; padding-bottom: .15rem; } .pg__b:hover { color: var(--sun); border-color: var(--sun); }
  @media (min-width: 62rem) { .pg { grid-template-columns: repeat(3, 1fr); } }
</style>
