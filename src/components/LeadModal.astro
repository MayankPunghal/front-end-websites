---
// "Book a call" popup: one question per step, native <dialog>. Same endpoint, method and field names as sunrooof.com
// (form.json). The POST goes to a hidden iframe so the visitor never leaves the page; success is shown in the dialog.
import form from '../data/form.json';
import { SITE } from '../lib/site';
const S = form.selects as Record<string, { label: string; options: string[] }>;
const clean = (l: string) => l.replace(/Sunrooof/g, 'SUNROOOF');
const chips = ['which_best_describes_you', 'Lead_Type', 'How_many_spaces_are_you_considering', 'Project_Stage', 'Timeline_for_Installing_SUNROOOF'];
const total = chips.length + 6;
---
<dialog class="lm" aria-labelledby="lm-q" data-lead-modal>
  <form method="post" action={SITE.formEndpoint} enctype="multipart/form-data" target="lm-frame" novalidate>
    <header class="lm__top">
      <span class="lm__count" data-count aria-live="polite">1 / {total}</span>
      <span class="lm__bar" aria-hidden="true"><i data-bar></i></span>
      <button class="lm__x" type="button" aria-label="Close" data-close>&times;</button>
    </header>

    <div class="lm__steps">
      {chips.map((name) => (
        <fieldset class="lm__step" data-step data-kind="chips" hidden>
          <legend>{clean(S[name].label)}</legend>
          <div class="lm__opts">
            {S[name].options.map((o) => <label class="lm__opt"><input type="radio" name={name} value={o} /><span>{o}</span></label>)}
          </div>
        </fieldset>
      ))}
      <div class="lm__step" data-step data-kind="field" hidden>
        <label for="lm-state" class="lm__q">{clean(S.state.label)}</label>
        <select id="lm-state" name="state" required>
          <option value="" disabled selected>Select a state</option>
          {S.state.options.map(o => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="lm__step" data-step data-kind="field" hidden>
        <label for="lm-city" class="lm__q">Which city is it in?</label>
        <input id="lm-city" name="city" type="text" autocomplete="address-level2" required />
      </div>
      <div class="lm__step" data-step data-kind="field" hidden>
        <label for="lm-name" class="lm__q">What is your name?</label>
        <input id="lm-name" name="Name" type="text" autocomplete="name" required />
      </div>
      <div class="lm__step" data-step data-kind="field" hidden>
        <label for="lm-mobile" class="lm__q">Your mobile number?</label>
        <input id="lm-mobile" name="mobile" type="tel" inputmode="numeric" autocomplete="tel-national" pattern="[0-9 +()\-]{8,16}" required />
      </div>
      <div class="lm__step" data-step data-kind="field" hidden>
        <label for="lm-email" class="lm__q">And your email?</label>
        <input id="lm-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="lm__step" data-step data-kind="last" hidden>
        <p class="lm__q" id="lm-last">Anything to help us plan? <span>Optional</span></p>
        <label class="lm__file">Upload the layout of your space (PNG, JPEG or PDF, max 10 MB)
          <input name="Upload_File" type="file" accept=".png,.jpg,.jpeg,.pdf" data-max-mb="10" />
        </label>
        <label class="lm__file">Which area of the layout do you want SUNROOOF in?
          <textarea name="specify_the_area_in_the_layout_where_you_want_the_sunroof" rows="3"></textarea>
        </label>
      </div>
    </div>

    <p class="lm__err" role="alert" data-err></p>
    <footer class="lm__nav">
      <button class="lm__back" type="button" data-back>Back</button>
      <button class="lm__next" type="button" data-next>Next</button>
      <button class="lm__next" type="submit" data-submit hidden>Request a call back</button>
    </footer>
  </form>
  <div class="lm__done" data-done hidden>
    <h2 id="lm-q">Thank you.</h2>
    <p>A SUNROOOF specialist will call you back as soon as possible. Prefer to talk now? Call <a href={`tel:${SITE.phone.in.replace(/\s/g, '')}`}>{SITE.phone.in}</a>.</p>
    <button class="lm__next" type="button" data-close>Close</button>
  </div>
  <iframe name="lm-frame" title="Form submission" hidden tabindex="-1"></iframe>
</dialog>

<style is:global>
  .lm { width: min(46rem, 100%); max-height: 100dvh; margin: auto; padding: 0; border: 0; background: var(--night); color: var(--on-night); overflow: hidden; }
  .lm::backdrop { background: rgb(0 0 0 / .72); backdrop-filter: blur(4px); }
  .lm[open] { animation: lm-in .5s var(--ease-out); }
  @keyframes lm-in { from { opacity: 0; transform: translateY(24px) scale(.98); } }
  .lm form { display: grid; grid-template-rows: auto 1fr auto auto; min-height: min(36rem, 100dvh); padding: clamp(1.25rem, 3vw, 2.5rem); gap: var(--s-6); }
  .lm__top { display: flex; align-items: center; gap: var(--s-4); }
  .lm__count { font-size: .8125rem; color: var(--on-night-2); font-variant-numeric: tabular-nums; min-width: 3.5rem; }
  .lm__bar { flex: 1; height: 2px; background: var(--line-night); } .lm__bar i { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: left; background: var(--sun); transition: transform .5s var(--ease-out); }
  .lm__x { width: 2.75rem; height: 2.75rem; background: none; border: 0; color: inherit; font-size: 1.75rem; cursor: pointer; }
  .lm__steps { display: grid; align-content: center; }
  .lm__step { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: var(--s-5); }
  .lm__step[hidden] { display: none; }
  .lm__step:not([hidden]) { animation: lm-step .5s var(--ease-out); }
  @keyframes lm-step { from { opacity: 0; transform: translateX(28px); } }
  .lm legend, .lm__q { font: 300 clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem)/1.1 var(--font-display); color: var(--on-night); padding: 0; }
  .lm__q span { font: 400 .875rem var(--font-body); color: var(--on-night-2); margin-left: .5rem; }
  .lm__opts { display: grid; gap: var(--s-2); margin-top: var(--s-4); }
  .lm__opt { position: relative; display: block; }
  .lm__opt input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .lm__opt span { display: flex; align-items: center; min-height: 3.25rem; padding: 0 var(--s-5); border: 1px solid var(--line-night); transition: background .3s, color .3s, border-color .3s; }
  .lm__opt:hover span { border-color: var(--on-night-2); }
  .lm__opt input:checked + span { background: var(--sun); color: var(--night); border-color: var(--sun); }
  .lm__opt input:focus-visible + span { outline: 2px solid var(--sun); outline-offset: 3px; }
  .lm input[type=text], .lm input[type=tel], .lm input[type=email], .lm select, .lm textarea { width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--on-night-2); color: var(--on-night); font-size: 1.25rem; padding: var(--s-3) 0; min-height: 3rem; border-radius: 0; }
  .lm select option { color: #111; }
  .lm input:focus, .lm select:focus, .lm textarea:focus { outline: 0; border-bottom-color: var(--sun); }
  .lm__file { display: grid; gap: var(--s-2); font-size: .9375rem; color: var(--on-night-2); }
  .lm__file input[type=file] { color: var(--on-night); }
  .lm__err { color: #ff9a80; min-height: 1.5rem; font-size: .9375rem; }
  .lm__nav { display: flex; justify-content: space-between; gap: var(--s-4); }
  .lm__back, .lm__next { min-height: 3rem; padding: 0 var(--s-6); font-size: .9375rem; text-transform: uppercase; letter-spacing: .02em; cursor: pointer; }
  .lm__back { background: none; border: 1px solid var(--line-night); color: var(--on-night); } .lm__back[hidden] { visibility: hidden; display: block; }
  .lm__next { background: var(--sun); border: 1px solid var(--sun); color: var(--night); margin-left: auto; font-weight: 500; }
  .lm__next[hidden] { display: none; }
  .lm__done { display: grid; gap: var(--s-5); padding: clamp(2rem, 6vw, 4rem); align-content: center; min-height: 20rem; }
  .lm__done a { color: var(--sun); }
  .lm__done h2 { color: var(--on-night); }
  .lm__done[hidden], .lm form[hidden] { display: none; }
  @media (max-width: 40rem) { .lm { width: 100%; height: 100dvh; } }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lead-modal]')!;
  const form = dlg.querySelector('form')!;
  const steps = [...dlg.querySelectorAll<HTMLElement>('[data-step]')];
  const [count, bar, err, done] = ['[data-count]', '[data-bar]', '[data-err]', '[data-done]'].map(s => dlg.querySelector<HTMLElement>(s)!);
  const back = dlg.querySelector<HTMLButtonElement>('[data-back]')!, next = dlg.querySelector<HTMLButtonElement>('[data-next]')!, submit = dlg.querySelector<HTMLButtonElement>('[data-submit]')!;
  let i = 0, sent = false;
  const MSG: Record<string, string> = { valueMissing: 'This is required.', typeMismatch: 'Enter a valid value.', patternMismatch: 'Enter a valid number.' };

  const show = (n: number, focus = true) => {
    i = Math.max(0, Math.min(steps.length - 1, n));
    steps.forEach((s, k) => (s.hidden = k !== i));
    count.textContent = `${i + 1} / ${steps.length}`;
    bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
    back.hidden = i === 0;
    const last = i === steps.length - 1;
    next.hidden = last; submit.hidden = !last;
    err.textContent = '';
    if (focus) steps[i].querySelector<HTMLElement>('input:not([type=radio]), .ui-select__btn, textarea, input[type=radio]:checked, input[type=radio]')?.focus({ preventScroll: true });
  };
  const valid = (): boolean => {
    const s = steps[i];
    if (s.dataset.kind === 'chips') { const ok = !!s.querySelector('input:checked'); err.textContent = ok ? '' : 'Choose one option.'; return ok; }
    for (const el of s.querySelectorAll<HTMLInputElement>('input[required], select[required]')) {
      if (!el.checkValidity()) { err.textContent = MSG[Object.keys(MSG).find(k => (el.validity as any)[k]) ?? 'valueMissing']; (el.closest('.ui-select')?.querySelector<HTMLElement>('.ui-select__btn') ?? el).focus(); return false; }
    }
    const f = s.querySelector<HTMLInputElement>('input[type=file]');
    if (f?.files?.[0] && f.files[0].size > Number(f.dataset.maxMb) * 1048576) { err.textContent = `The file is over ${f.dataset.maxMb} MB. Choose a smaller one.`; return false; }
    return true;
  };
  const go = () => { if (valid()) show(i + 1); };

  const open = (pre?: string) => { if (!dlg.open) { sent = false; form.hidden = false; done.hidden = true; show(0, false); dlg.showModal(); document.body.style.overflow = 'hidden'; show(0); const t = dlg.querySelector('textarea'); if (t) t.value = pre ?? ''; } };
  document.addEventListener('click', e => {
    const a = (e.target as HTMLElement).closest('[data-lead]');
    if (a) { e.preventDefault(); open((a as HTMLElement).dataset.prefill); }
    else if ((e.target as HTMLElement).closest('[data-close]')) dlg.close();
  });
  dlg.addEventListener('close', () => { document.body.style.overflow = ''; });
  dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  back.addEventListener('click', () => show(i - 1));
  next.addEventListener('click', go);
  steps.forEach(s => s.querySelectorAll('input[type=radio]').forEach(r => r.addEventListener('change', () => setTimeout(go, 260))));
  form.addEventListener('keydown', e => { if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA' && i < steps.length - 1) { e.preventDefault(); go(); } });
  form.addEventListener('submit', e => { if (!valid()) { e.preventDefault(); return; } sent = true; });
  dlg.querySelector('iframe')!.addEventListener('load', () => { if (sent) { form.hidden = true; done.hidden = false; } });
</script>
