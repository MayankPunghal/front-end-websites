---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import { SITE } from '../lib/site';
import { localize } from '../lib/img';

interface Props { title: string; description?: string; image?: string; header?: 'paper' | 'night'; tone?: 'paper' | 'night'; noindex?: boolean; announce?: string; staticHeader?: boolean; }
const { staticHeader = false, announce, title, description = 'SUNROOOF brings the feel of natural daylight indoors: sun lighting for homes, offices, hotels, retail spaces and premium interiors.', image, header = 'paper', tone = 'paper', noindex = false } = Astro.props;
const full = title.includes('SUNROOOF') ? title : `${title} | SUNROOOF`;
const page = localize(await Astro.slots.render('default'));
const canonical = new URL(Astro.url.pathname, SITE.liveOrigin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin />
    <script is:inline>
      // Reveal states only exist when motion is allowed; if the animation chunk never arrives, content must not stay hidden.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(() => { if (!window.__motionReady) document.documentElement.classList.remove('motion'); }, 4000);
      }
    </script>
    <script is:inline>
      // Logo loader: shown once per session, only until the page has loaded (max 4 s).
      try { if (!sessionStorage.getItem('sr-loaded')) document.documentElement.classList.add('loading'); } catch {}
    </script>
    <style is:global>
      .loader { position: fixed; inset: 0; z-index: 200; display: none; place-items: center; background: #121212; transition: opacity .7s var(--ease-in-out), visibility .7s; }
      html.loading .loader { display: grid; } .loader.done { opacity: 0; visibility: hidden; }
      html.loading { overflow: hidden; }
      .loader [data-loader-anim] { width: 100vw; }
      .announce { margin: 0; padding: .5rem 1rem; background: var(--sun); color: #111; text-align: center; font-size: .8125rem; line-height: 1.4; }
    </style>
    <noscript><style>.loader { display: none !important; } html.loading { overflow: auto; }</style></noscript>
    <slot name="head" />
  </head>
  <body class={tone === 'night' ? 'tone-night' : undefined}>
    <div class="loader" aria-hidden="true" data-loader><div data-loader-anim></div></div>
    <script is:inline>
      (() => {
        const el = document.querySelector('[data-loader]'); if (!el) return;
        const root = document.documentElement; if (!root.classList.contains('loading')) { el.remove(); return; }
        const t0 = performance.now();
        const done = () => { const wait = Math.max(0, 3800 - (performance.now() - t0)); setTimeout(() => { el.classList.add('done'); root.classList.remove('loading'); try { sessionStorage.setItem('sr-loaded', '1'); } catch {} setTimeout(() => el.remove(), 800); }, wait); };
        if (document.readyState === 'complete') done(); else addEventListener('load', done, { once: true });
        setTimeout(done, 5000);
      })();
    </script>
    <a class="skip" href="#main">Skip to content</a>
    {announce && <p class="announce">{announce}</p>}
    <Header theme={header} path={Astro.url.pathname} fixed={!staticHeader} />
    <main id="main" set:html={page} />
    <LeadModal />
    <Footer />
    <script is:inline>
      // Images that finish loading after first paint sharpen in from their placeholder; cached ones just appear.
      addEventListener('load', e => { const i = e.target; if (i.tagName === 'IMG' && i.hasAttribute('data-lq')) { i.classList.add('lq-in'); i.addEventListener('animationend', () => i.classList.remove('lq-in'), { once: true }); } }, true);
    </script>
    <script>import '../scripts/motion'; import '../scripts/smooth'; import '../scripts/loader';</script>
  </body>
</html>
