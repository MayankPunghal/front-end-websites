---
import Base from '../../layouts/Base.astro';
import GetInTouch from '../../components/GetInTouch.astro';
const P = '+91 9811773388';
const offices = [
  ['Delhi Flagship', 'Plot 352, Mehrauli-Gurgaon Rd, Sultanpur, New Delhi, Delhi 110030'],
  ['Bengaluru Flagship', 'SUNROOOF 1154, 12th Main Rd, HAL 2nd Stage, Indiranagar, Bengaluru, Karnataka - 560038'],
  ['Delhi (West)', '12/1, WHS, Block A, Kirti Nagar Industrial Area, Kirti Nagar, Delhi, 110015'],
  ['Mumbai', 'Office no 1615B, 16th floor, One Lodha Place, Senapati Bapat Marg, Dadar West, Lower Parel, Mumbai, Maharashtra 400013'],
  ['Mohali', 'SCO 66, Sector 82, JLPL Industrial Area, Sahibzada Ajit Singh Nagar, Punjab 140306'],
  ['Surat', 'SUNROOOF Solaris Cube Ground floor Vesu, Maharana Pratap Road Surat - 395007'],
  ['Hyderabad', 'Coming Soon'],
  ['Dubai', ''],
];
---
<Base tone="night" title="Contact" description="Talk to a SUNROOOF specialist: request a call back, phone or email. Experience centres across India and Dubai.">
  <h1 class="ct__h">Get in Touch with Us</h1>
  <GetInTouch id="contact" page />
  <section class="ct__o">
    <img data-reveal src="https://sunrooof.com/cdn/shop/files/footer-glove.png?width=1500" width="750" height="750" alt="" loading="lazy" />
    <ul>
      {offices.map(([n, a]) => <li data-reveal><h3>{n}</h3>{a && <p>{a}</p>}{a !== 'Coming Soon' && <a href={`tel:${P.replace(/\s/g, '')}`}>{P}</a>}</li>)}
    </ul>
  </section>
</Base>

<style>
  .ct__h { font: 300 clamp(2.25rem, 1.6rem + 1.6vw, 2.5rem)/1.2 var(--font-display); max-width: 11ch; margin: 0; padding: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 0.5rem + 3vw, 3.25rem) 0; color: #fff; }
  .ct__o { display: grid; gap: 2rem; padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); border-top: 1px solid rgb(255 255 255 / .3); color: #fff; }
  .ct__o img { width: min(100%, 30rem); height: auto; align-self: center; }
  .ct__o ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); align-content: center; }
  .ct__o h3 { font: 400 .9375rem/1.2 var(--font-body); text-transform: uppercase; margin: 0 0 1rem; color: #fff; }
  .ct__o p { margin: 0 0 1rem; font-size: .875rem; line-height: 1.5; color: #9d9fa1; max-width: 18rem; }
  .ct__o a { font-size: .875rem; color: #9d9fa1; text-decoration: none; } .ct__o a:hover { color: var(--sun); }
  @media (min-width: 62rem) { .ct__o { grid-template-columns: 1fr 1.1fr; gap: 4rem; padding-block: 5rem; } .ct__o ul { grid-template-columns: 1fr 1fr; padding-left: 4rem; } }
</style>
