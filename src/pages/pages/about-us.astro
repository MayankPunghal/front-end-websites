---
import Base from '../../layouts/Base.astro';
import GetInTouch from '../../components/GetInTouch.astro';
import { L } from '../../lib/live';
const team = [['Ishat Jain (Co-Founder)', 'Ishat.png'], ['Vinod Jain (Co-Founder)', 'Vinod.png'], ['Christoph Hoeynck (Director | Germany)', 'Christoph.png'], ['Susan Sadolin (Director | USA)', 'Susan.png'], ['Serge Cornellisen (Product Designer | Belgium)', 'Serge_1.jpg'], ['Alla (Product Designer | Ukraine)', 'Product.png']];
---
<Base title="About" description="SUNROOOF, a subsidiary of the MAGPPIE Group, makes a lighting system that turns any ceiling into a sky.">
  <section class="ab">
    <div class="ab__top">
      <div class="ab__hw"><h1 class="ab__h1">Technology that brings you sunlight, and a little more joy.</h1></div>
      <img data-reveal src={L('hero.png', 1200)} width="864" height="773" alt="Hanging plants under a SUNROOOF skylight" />
      <p class="ab__lead"><b>SUNROOOF</b>, a subsidiary of the MAGPPIE Group, has pioneered the world’s first lighting system that transforms any ceiling into a sky. Using advanced optics and design, our technology recreates the feeling of being outdoors—so you feel the sky above you, even when you’re indoors.</p>
      <div class="ab__stats" data-stats>
        <div class="ab__l"><b data-countup="4" data-suffix="+">4+</b><span>years of Researching and Development</span></div>
        <div class="ab__r"><img src={L('counter2.png', 400)} width="184" height="81" alt="The SUNROOOF research team" loading="lazy" /><b data-countup="12">12</b><span>World Class Scientists</span></div>
      </div>
      <div class="ab__vw"><video class="ab__vid" data-zoom src="/video/about.mp4" poster="/video/about.jpg" muted loop playsinline preload="none" aria-label="Light moving through a forest"></video></div>
    </div>
    <div class="ab__team">
      <p class="ab__k">Our Team</p>
      <h2>We’re a collective of innovators, working to bring the health of natural sunlight into everyday indoor spaces.</h2>
      <ul>{team.map(([n, f]) => <li><img src={L(f, 600)} width="300" height="442" alt={n} loading="lazy" /><p>{n}</p></li>)}</ul>
    </div>
    <div class="ab__ws">
      <img src={L('workspace.png', 1200)} width="720" height="811" alt="The SUNROOOF workspace" loading="lazy" />
      <div><p class="ab__k">International Headquarters</p><h2>Workspace Overview</h2><p>We innovated a technologically advanced lighting system, which brings the experience of Sunlight indoors. It feels like you are outdoors even when you’re indoors!</p><a href="/pages/contact-us">Contact us</a></div>
    </div>
  </section>
  <GetInTouch id="about" />
</Base>

<style>
  .ab { background: #fff; color: #111; font-family: Arial, 'DM Sans', sans-serif; }
  .ab__top { display: grid; gap: 1.5rem; padding: 1.5rem clamp(1rem, 0.5rem + 3vw, 3.25rem) clamp(5rem, 14vw, 9rem); }
  .ab__top img { width: 100%; height: auto; max-width: 44rem; }
  .ab__h1 { font: 300 clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem)/1.25 var(--font-display); margin: 0; max-width: 14ch; }
  .ab__lead { margin: 0; font-size: 1.125rem; line-height: 1.45; max-width: 30rem; }
  .ab__stats { display: grid; gap: 2rem; font-size: 1.125rem; }
  .ab__stats b { display: block; font: 300 clamp(3rem, 2rem + 3vw, 4rem)/1 var(--font-display); } .ab__stats span { display: block; max-width: 10rem; line-height: 1.3; }
  .ab__l, .ab__r { display: grid; align-content: start; gap: .25rem; } .ab__r { justify-items: end; text-align: right; } .ab__r span { margin-left: auto; } .ab__r img { width: 11.5rem; height: auto; margin-bottom: 1rem; }
  .ab__vw { position: relative; } .ab__vid { display: block; width: min(19.7rem, 70%); height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: #222; transform-origin: 0 0; will-change: transform; }
  .ab { overflow-x: clip; }
  .ab__team { padding: clamp(5rem, 16vw, 14rem) 0 clamp(3rem, 7vw, 7rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); }
  .ab__k { margin: 0 0 1rem; font-size: 1.125rem; color: #6b6b6b; }
  .ab__team h2, .ab__ws h2 { font: 300 clamp(1.5rem, 1.1rem + 1.2vw, 1.75rem)/1.25 var(--font-display); margin: 0 0 2rem; max-width: 24rem; }
  .ab__team ul { display: flex; gap: .5rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 1rem clamp(1rem, 0.5rem + 3vw, 3.25rem) 0 0; margin: 0; list-style: none; scrollbar-width: none; }
  .ab__team li { flex: 0 0 min(18.75rem, 70vw); scroll-snap-align: start; } .ab__team li img { width: 100%; height: auto; display: block; filter: grayscale(1); } .ab__team li p { margin: .75rem 0 0; font-size: 1rem; line-height: 1.3; }
  .ab__ws { display: grid; } .ab__ws img { width: 100%; height: 100%; object-fit: cover; min-height: 20rem; } .ab__ws > div { padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem); align-self: center; }
  .ab__ws > div p:last-of-type { max-width: 24rem; line-height: 1.5; margin: 0 0 2rem; font-size: 1rem; }
  .ab__ws a { color: #111; text-transform: uppercase; font-size: .75rem; text-decoration: none; border-bottom: 1px solid #111; padding: .5rem .25rem; }
  @media (min-width: 62rem) {
    .ab__team.is-pinned { padding-block: 0; min-height: calc(100svh - 4.5rem); align-content: center; overflow: hidden; } .ab__team.is-pinned ul { overflow: visible; gap: 3rem; padding-left: 28vw; will-change: transform; } .ab__team.is-pinned li { flex-basis: 18.75rem; }
    .ab__top { grid-template-columns: 40% 1fr; padding-top: 3rem; } .ab__vw { grid-column: 2; height: calc(61.9vw + 4rem); } .ab__vid { width: 19.7rem; } .ab__hw { grid-column: 1; grid-row: 1 / span 3; } .ab__h1 { position: sticky; top: 38vh; } .ab__top img, .ab__top .ab__lead, .ab__top .ab__stats { grid-column: 2; max-width: none; } .ab__top img { max-width: 54rem; } .ab__stats { grid-template-columns: 1fr 1fr; margin-top: 3rem; padding-right: 3rem; }
    .ab__team { display: grid; grid-template-columns: 40% 1fr; } .ab__team > p, .ab__team > h2 { grid-column: 1; } .ab__team ul { grid-column: 1 / -1; }
    .ab__ws { grid-template-columns: 1fr 1fr; min-height: 50rem; }
  }
</style>

<script>
  import { motion } from '../../scripts/motion';
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const vid = document.querySelector<HTMLVideoElement>('[data-zoom]')!;
  // counters: count up once when they scroll into view
  document.querySelectorAll<HTMLElement>('[data-countup]').forEach(el => {
    const end = Number(el.dataset.countup), suf = el.dataset.suffix ?? '';
    if (calm) return;
    el.textContent = '0' + suf;
    new IntersectionObserver((es, io) => { if (!es[0].isIntersecting) return; io.disconnect(); const t0 = performance.now(); const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1400); el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))) + suf; if (k < 1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); }, { threshold: 0.6 }).observe(el);
  });
  // video plays while on screen
  new IntersectionObserver(es => es.forEach(e => (e.isIntersecting ? (vid.preload = 'auto', vid.play().catch(() => {})) : vid.pause())), { rootMargin: '20% 0px' }).observe(vid);
  // desktop: the small video zooms to fill the viewport as you scroll (scrubbed, like the live site)
  motion().then(({ gsap, ScrollTrigger, mm }) => {
    // team photos: pinned, the vertical scroll drives them sideways
    mm.add('(min-width: 62rem) and (prefers-reduced-motion: no-preference)', () => {
      const team = document.querySelector<HTMLElement>('.ab__team')!, track = team.querySelector<HTMLElement>('ul')!;
      team.classList.add('is-pinned');
      const dist = () => track.scrollWidth - innerWidth + 96;
      gsap.to(track, { x: () => -dist(), ease: 'none', scrollTrigger: { trigger: team, start: 'top top+=72', end: () => '+=' + dist(), pin: true, scrub: 1, invalidateOnRefresh: true, anticipatePin: 1 } });
      return () => team.classList.remove('is-pinned');
    });
    mm.add('(min-width: 62rem) and (prefers-reduced-motion: no-preference)', () => {
      // room for the full-size video is reserved in the layout, so growing it never covers other content
      const box = vid.parentElement!;
      gsap.to(vid, { scale: () => (innerWidth * 1.1) / vid.offsetWidth, x: () => -(box.getBoundingClientRect().left + scrollX) - innerWidth * 0.05, ease: 'none', scrollTrigger: { trigger: box, start: 'top 65%', end: 'top 18%', scrub: true, invalidateOnRefresh: true } });
    });
  });
</script>
