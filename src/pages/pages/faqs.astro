---
import Base from '../../layouts/Base.astro';
import faqs from '../../data/faqs.json';
const norm = (t: string) => t.replace(/[’']/g, "'").toLowerCase().trim();
// each tab shows the curated list the original shows ("All" is not the union of the other two)
const tabs: Record<string, string[]> = {
  All: ['Is this a real skylight', 'Does SUNROOOF change colour', 'Is it customisable', 'What is the lead time', 'What is the Guarantee', "What if there's a problem", 'Is SUNROOOF compatible with smart', 'What is the power consumption of', 'Can SUNROOOF be used in commercial', 'How is SUNROOOF installed'],
  Console: ['Where is SUNROOOF manufactured', 'How does SUNROOOF improve', 'Is this a real skylight', 'Does SUNROOOF change colour', 'Is SUNROOOF similar to a LED', 'Does it get dark patches', 'What happens at night', 'Does this light provide Vitamin D', 'Does SUNROOOF offer any health', 'Do you sell only the light console', 'Can it be integrated', 'What is the power consumption?', 'What type of wood', 'What type of glass', 'Is SUNROOOF the same as Stretch'],
  Installation: ['How long does the installation take', 'How can it be cleaned', 'What is required from the customer', 'How long does it take for your team', 'What is the minimum height'],
};
const groups = Object.keys(tabs);
const pick = (g: string) => tabs[g].map(q => faqs.find(f => norm(f.q).startsWith(norm(q)))!);
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base tone="night" title="FAQs" description="Answers about SUNROOOF: how the light works, installation, sizing, guarantee and payment.">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <h1 class="fq__h">Everything<br />You Need to Know.</h1>
  <section class="fq" data-faq>
    <div class="fq__tabs" role="tablist" aria-label="Filter questions">
      {groups.map((g, i) => <button type="button" role="tab" aria-selected={i === 0} data-g={g}>{g}</button>)}
    </div>
    {groups.map((g, gi) => (
      <div class="fq__list" data-pane={g} hidden={gi > 0}>
        {pick(g).map((f, i) => (
          <details class="fq__i" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    ))}
    <p class="fq__more">Have more questions?<a href="/pages/contact-us">Contact us</a></p>
  </section>
</Base>

<style>
  .fq__h { font: 300 clamp(2rem, 1.6rem + 1.4vw, 2.5rem)/1.2 var(--font-display); margin: 0; padding: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 0.5rem + 3vw, 3.25rem) 0; color: #fff; }
  .fq { padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 0.5rem + 3vw, 3.25rem) clamp(3rem, 7vw, 6rem); color: #fff; }
  .fq__tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid rgb(255 255 255 / .4); margin-bottom: 2.5rem; }
  .fq__tabs button { position: relative; padding: .875rem 0; background: none; border: 0; color: #fff; font: inherit; font-size: clamp(.9375rem, .8rem + .5vw, 1.125rem); text-transform: uppercase; cursor: pointer; }
  .fq__tabs button::before { content: ''; position: absolute; left: 10%; right: 10%; bottom: 0; height: 1.5rem; background: radial-gradient(ellipse at 50% 100%, rgb(255 201 51 / .45), transparent 70%); opacity: 0; transition: opacity .4s; pointer-events: none; }
  .fq__tabs button[aria-selected=true]::before { opacity: 1; }
  .fq__list[hidden] { display: none; }
  .fq__i { border-bottom: 1px solid rgb(120 120 120); }
  .fq__i[hidden] { display: none; }
  .fq__i[open] { background: rgb(255 255 255 / .04); }
  .fq__i summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; align-items: center; min-height: 3.5rem; padding: 1rem 1.25rem; font: 400 clamp(1rem, .9rem + .4vw, 1.125rem)/1.3 var(--font-body); }
  .fq__i summary::-webkit-details-marker { display: none; }
  .fq__i summary::after { content: ''; flex: none; width: .5rem; height: .5rem; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); transition: transform .3s var(--ease-out); }
  .fq__i[open] summary::after { transform: rotate(225deg); }
  .fq__i p { margin: 0; padding: 0 1.25rem 1.25rem; color: #9d9fa1; font-size: .875rem; max-width: 70ch; }
  .fq__more { display: grid; justify-items: center; gap: .75rem; margin: 3rem 0 0; font-size: .8125rem; }
  .fq__more a { color: #fff; text-transform: uppercase; font-size: .75rem; text-decoration: none; border-bottom: 1px solid #fff; padding: .4rem .25rem; } .fq__more a:hover { color: var(--sun); border-color: var(--sun); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-faq]');
  root?.querySelectorAll<HTMLButtonElement>('[data-g]').forEach(b => b.addEventListener('click', () => {
    root.querySelectorAll('[data-g]').forEach(x => x.setAttribute('aria-selected', String(x === b)));
    root.querySelectorAll<HTMLElement>('[data-pane]').forEach(p => { p.hidden = p.dataset.pane !== b.dataset.g; });
  }));
</script>
