---
import Base from '../../layouts/Base.astro';
import CollectionView from '../../components/CollectionView.astro';
import CollectionLanding from '../../components/CollectionLanding.astro';
import pages from '../../data/collection-pages.json';
import { COLLECTIONS } from '../../lib/site';
export const getStaticPaths = () => [...COLLECTIONS.map(c => c.handle), 'all'].map(handle => ({ params: { handle } }));
const { handle } = Astro.params;
const col = COLLECTIONS.find(c => c.handle === handle);
const landing = !!col && handle! in pages;
---
<Base tone="night" title={col ? `${col.title} collection` : 'All products'} description={col ? `${col.title} SUNROOOF designs for natural daylight interiors.` : 'SUNROOOF skylights, windows and accessories.'}>
  {landing ? <CollectionLanding handle={handle!} /> : <CollectionView handle={handle!} />}
</Base>
