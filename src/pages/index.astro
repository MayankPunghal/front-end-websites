---
import '@fontsource-variable/mona-sans/wdth.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sites = [
  { href: 'sunrooof', title: 'Sunrooof', line: 'One day in one room, told in a single scroll.' },
  { href: 'original', title: 'Sunrooof Original', line: 'The sunrooof.com rebuild, with the film as its hero.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Front-end websites</title>
    <meta name="description" content="Website concepts, each in its own directory." />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <style is:global>
      :root { --bg: #0c0b0a; --fg: #f3ede2; --mute: #9a9184; --sun: #ffb648; --line: #2c2823; --font: 'Mona Sans Variable', system-ui, sans-serif; }
      html, body { overflow-x: clip; } body { margin: 0; background: var(--bg); color: var(--fg); font: 400 1.0625rem/1.5 var(--font); }
      main { max-width: 88rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 4rem); min-height: 100svh; display: grid; align-content: start; gap: clamp(2rem, 5vw, 4rem); box-sizing: border-box; }
      h1 { margin: 0; font-size: clamp(1.125rem, 1rem + .5vw, 1.375rem); font-weight: 500; }
      ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
      .tile { display: block; color: inherit; text-decoration: none; }
      .tile:focus-visible { outline: 2px solid var(--sun); outline-offset: 4px; }
      .frame { display: block; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 8 / 5; }
      .frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
      h2 { margin: 1.25rem 0 .25rem; font-size: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem); line-height: 1.1; font-weight: 300; font-stretch: 112%; letter-spacing: -.025em; transition: color .25s; }
      .tile:hover h2 { color: var(--sun); }
      p { margin: 0; color: var(--mute); }
      @media (prefers-reduced-motion: no-preference) { .frame img { transition: transform .6s cubic-bezier(.2, .7, .2, 1); } .tile:hover img { transform: scale(1.03); } }
    </style>
  </head>
  <body>
    <main>
      <h1>Front-end websites</h1>
      <ul>
        {sites.map(s => (
          <li><a class="tile" href={`${base}/${s.href}/`}>
            <span class="frame"><img src={`${base}/previews/${s.href}.jpg`} alt="" width="1200" height="758" /></span>
            <h2>{s.title}</h2>
            <p>{s.line}</p>
          </a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
