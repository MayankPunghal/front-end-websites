---
import '@fontsource-variable/mona-sans/wdth.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const planned = ['The machine first', 'Architecture monograph'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Front-end websites</title>
    <meta name="description" content="Website concepts, each in its own directory." />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <style is:global>
      :root { --bg: #0c0b0a; --fg: #f3ede2; --mute: #9a9184; --sun: #ffb648; --line: #2c2823; --font: 'Mona Sans Variable', system-ui, sans-serif; }
      html, body { overflow-x: clip; } body { margin: 0; background: var(--bg); color: var(--fg); font: 400 1.0625rem/1.5 var(--font); }
      main { max-width: 88rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 4rem); min-height: 100svh; display: grid; align-content: space-between; gap: 4rem; box-sizing: border-box; }
      h1 { margin: 0; font-size: clamp(1.125rem, 1rem + .5vw, 1.375rem); font-weight: 500; }
      ol { list-style: none; margin: 0; padding: 0; } li { border-top: 1px solid var(--line); }
      a.row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1.5rem; padding-block: 1.5rem; color: inherit; text-decoration: none; transition: color .25s; }
      a.row:hover { color: var(--sun); } a.row:focus-visible { outline: 2px solid var(--sun); outline-offset: 4px; }
      .name { font-size: clamp(3rem, 1rem + 9vw, 9rem); line-height: .95; font-weight: 300; font-stretch: 112%; letter-spacing: -.035em; overflow-wrap: break-word; min-width: 0; }
      .next { display: flex; justify-content: space-between; gap: 1.5rem; padding-block: 1rem; color: var(--mute); }
      .meta { color: var(--mute); }
    </style>
  </head>
  <body>
    <main>
      <h1>Front-end websites</h1>
      <ol>
        <li><a class="row" href={`${base}/sunrooof/`}><span class="name">Sunrooof</span><span class="meta">One day, one scroll</span></a></li>
        {planned.map(p => <li class="next"><span>Sunrooof: {p}</span><span>Not built yet</span></li>)}
        <li class="next"><span>Sunrooof: original rebuild</span><span>On the main branch</span></li>
      </ol>
    </main>
  </body>
</html>
