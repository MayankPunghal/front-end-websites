---
import Base from '../../../layouts/Base.astro';
import Pic from '../../../components/Pic.astro';
import GetInTouch from '../../../components/GetInTouch.astro';
import articles from '../../../data/articles.json';
export const getStaticPaths = () => articles.map(a => ({ params: { handle: a.handle }, props: { a } }));
const { a } = Astro.props;
const H = new Set(a.headings);
const https = (u: string) => u.replace(/^http:/, 'https:');
// body is a flat list of paragraphs and headings; headings are known by text. Everything after the FAQs heading is Q/A.
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: a.title, description: a.description, image: https(a.image), datePublished: new Date(a.date).toISOString().slice(0, 10), publisher: { '@type': 'Organization', name: 'SUNROOOF' } };
const more = articles.filter(x => x.handle !== a.handle).slice(0, 3);
---
<Base title={a.title} description={a.description} image={https(a.image)}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="wrap ar">
    <nav class="ar__crumbs" aria-label="Breadcrumb"><a href="/">Home</a><a href="/blogs/news">Journal</a></nav>
    <header>
      <p class="kicker">{a.date}</p>
      <h1>{a.title}</h1>
      <p class="lead">{a.description}</p>
    </header>
    <Pic class="ar__hero" src={https(a.image)} alt="" widths={[600, 1000, 1500]} sizes="(min-width: 62rem) 60rem, 100vw" w={1500} h={900} eager />
    <div class="ar__body">
      {a.body.map(t => H.has(t) ? <h2>{t}</h2> : <p>{t}</p>)}
    </div>
  </article>
  <section class="wrap ar__more">
    <h2>Keep reading</h2>
    <ul>{more.map(m => <li><a href={`/blogs/news/${m.handle}`}><span class="muted">{m.date}</span><b>{m.title}</b></a></li>)}</ul>
  </section>
  <GetInTouch id="article" />
</Base>

<style is:global>
  .ar { padding-block: var(--s-6) var(--s-9); display: grid; gap: var(--s-6); justify-items: center; }
  .ar > * { width: 100%; max-width: 46rem; }
  .ar__crumbs { display: flex; gap: var(--s-3); font-size: var(--t-small); } .ar__crumbs a { color: var(--ink-3); text-decoration: none; } .ar__crumbs a:hover { text-decoration: underline; }
  .ar__crumbs a:not(:last-child)::after { content: '/'; margin-left: var(--s-3); }
  .ar header { display: grid; gap: var(--s-4); } .ar h1 { font-size: var(--t-h2); line-height: 1; }
  .ar__hero { max-width: 60rem; width: 100%; height: auto; aspect-ratio: 5/3; object-fit: cover; border-radius: var(--r-1); background: var(--paper-3); }
  .ar__body { display: grid; gap: var(--s-4); } .ar__body h2 { font-size: var(--t-h3); margin-top: var(--s-6); line-height: 1.05; } .ar__body p { color: var(--ink-2); font-size: 1.0625rem; line-height: 1.7; }
  .ar__more { padding-bottom: var(--section); } .ar__more h2 { font-size: var(--t-h3); margin-bottom: var(--s-5); }
  .ar__more ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .ar__more a { display: grid; gap: var(--s-1); text-decoration: none; border-top: 1px solid var(--ink); padding-top: var(--s-3); } .ar__more a:hover b { color: var(--brass-ink); }
</style>
