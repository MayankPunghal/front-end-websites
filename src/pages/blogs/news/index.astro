---
import Base from '../../../layouts/Base.astro';
import Pic from '../../../components/Pic.astro';
import articles from '../../../data/articles.json';
const https = (u: string) => u.replace(/^http:/, 'https:');
const top = articles.slice(0, 4);
const arrow = '<svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8"/></svg>';
---
<Base title="Journal" description="Ideas on daylight, lighting design and skylights from SUNROOOF.">
  <section class="bl" data-bl>
    <h1>Top Posts</h1>
    <div class="bl__t" data-bl-track>
      {top.map(a => (
        <a class="bl__f" href={`/blogs/news/${a.handle}`}>
          <Pic src={https(a.image)} alt="" widths={[700, 1100]} sizes="(min-width: 62rem) 50vw, 92vw" w={1100} h={730} eager />
          <div><time>{a.date}</time><h2>{a.title}</h2><p>{a.description}</p><span set:html={arrow}></span></div>
        </a>
      ))}
    </div>
    <div class="bl__n"><button type="button" aria-label="Previous post" data-bl-prev>‹</button>{top.map((_, i) => <i data-dot class:list={{ on: i === 0 }}></i>)}<button type="button" aria-label="Next post" data-bl-next>›</button></div>
    <h2 class="bl__all">All posts</h2>
    <ul class="bl__l">
      {articles.map(a => (
        <li>
          <a href={`/blogs/news/${a.handle}`}>
            <div><time>{a.date}</time><h3>{a.title}</h3><p>{a.description}</p><span set:html={arrow}></span></div>
            <Pic src={https(a.image)} alt="" widths={[400, 700]} sizes="(min-width: 62rem) 22vw, 40vw" w={700} h={470} />
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .bl { background: #fff; color: #111; padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 0.5rem + 3vw, 2.25rem) clamp(3rem, 7vw, 6rem); }
  .bl h1 { font: 300 clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem)/1.2 var(--font-display); text-align: center; margin: 0 0 2rem; color: #111; }
  .bl__t { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .bl__f { flex: 0 0 100%; scroll-snap-align: start; display: grid; gap: 1.5rem; align-items: center; color: #111; text-decoration: none; }
  .bl__f img, .bl__l img { width: 100%; height: auto; display: block; object-fit: cover; }
  .bl time { font-size: .875rem; text-decoration: underline; } .bl__f h2 { font: 300 clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem)/1.2 var(--font-display); margin: 1rem 0; color: #111; } .bl p { margin: 0 0 1rem; font-size: .75rem; line-height: 1.5; max-width: 34rem; }
  .bl__n { display: flex; justify-content: center; align-items: center; gap: .5rem; margin: 1.5rem 0 3rem; } .bl__n button { background: none; border: 0; font-size: 1.5rem; cursor: pointer; padding: .25rem .75rem; color: #111; } .bl__n i { width: 1.25rem; height: 4px; background: #d6d6d6; transition: background .3s; } .bl__n i.on { background: var(--sun); }
  .bl__all { font: 300 1.5rem/1.2 var(--font-display); margin: 0 0 1rem; color: #111; }
  .bl__l { list-style: none; margin: 0; padding: 0; } .bl__l li { border-bottom: 1px solid #e3e3e3; } .bl__l a { display: grid; grid-template-columns: 1fr minmax(8rem, 28%); gap: 1.25rem; align-items: center; padding-block: 1.5rem; color: #111; text-decoration: none; }
  .bl__l h3 { font: 400 clamp(1.125rem, 1rem + .6vw, 1.5rem)/1.25 var(--font-body); margin: .5rem 0; } .bl__l a:hover h3 { text-decoration: underline; }
  @media (min-width: 62rem) { .bl__f { grid-template-columns: 1fr 1fr; gap: 3rem; } .bl__f > :first-child { order: 0; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-bl]');
  if (root) {
    const tr = root.querySelector<HTMLElement>('[data-bl-track]')!, dots = [...root.querySelectorAll('[data-dot]')];
    const go = (d: number) => tr.scrollBy({ left: d * tr.clientWidth, behavior: 'smooth' });
    root.querySelector('[data-bl-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-bl-next]')!.addEventListener('click', () => go(1));
    tr.addEventListener('scroll', () => { const i = Math.round(tr.scrollLeft / tr.clientWidth); dots.forEach((d, k) => d.classList.toggle('on', k === i)); }, { passive: true });
  }
</script>
