---
import Layout from '../../../sites/sunrooof/Layout.astro';
import Footer from '../../../sites/sunrooof/Footer.astro';
import { parts, reasons } from '../../../sites/sunrooof/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="How SUNROOOF works" description="An illustrative look at the layers inside SUNROOOF: advanced optics, special lenses and AI.">
  <section class="parts" data-parts>
    <div class="parts__pin">
      <canvas aria-hidden="true"></canvas>
      <div class="parts__copy">
        <div class="part" data-part data-on><h1>Engineered to bring Sun Indoors</h1><p>Advanced optics, special lenses and AI.</p></div>
        {parts.map(([n, d]) => <div class="part" data-part><h2>{n}</h2><p>{d}</p></div>)}
      </div>
      <p class="parts__note">Illustrative model, based on the SUNROOOF product film</p>
    </div>
  </section>
  <section class="reasons wrap">
    {reasons.map(([t, v]) => <div><h2>{t}</h2><video src={`${base}/video/${v}.mp4`} poster={`${base}/video/${v}.jpg`} muted loop playsinline preload="none" width="1600" height="900" data-v></video></div>)}
  </section>
  <Footer />
</Layout>
<script>
  import '../../../sites/sunrooof/anatomy';
</script>
