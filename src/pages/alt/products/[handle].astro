---
import Base from '../../../layouts/Base.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import ProductStory from "../../../components/ProductStory.astro";
import products from '../../../data/products.json';
import { COLLECTIONS, inr, clean, collectionOf, productsOf } from '../../../lib/site';
import { L } from '../../../lib/live';

export const getStaticPaths = () => products.map(p => ({ params: { handle: p.handle }, props: { p } }));
const { p } = Astro.props;
const col = collectionOf(p);
const sized = p.variants.filter(v => v.cols);
const def = p.variants.find(v => v.isDefault) ?? p.variants[0];
const sibs = p.finish ? productsOf(p.family).filter(s => s.finish) : [];
const related = products.filter(x => x.handle !== p.handle && x.kind === p.kind && x.family !== p.family).slice(0, 3);
const FINISH: Record<string, string> = { White: '#ece9e2', Wooden: '#b07a45', Bronze: '#8a6a3d', 'Titanium Grey': '#7d8085', Black: '#1b1a18' };
// per-grid room photo: file names carry the grid ("4x2"). First match wins; fall back to the hero.
const photoFor = (v: { cols: number | null; rows: number | null }) => v.cols ? p.images.find(i => new RegExp(`[^0-9]${v.cols}x${v.rows}[^0-9]`, 'i').test(i.split('/').pop()!.replace(/^/, '_'))) : undefined;
const variants = p.variants.map(v => ({ id: v.id, t: v.title, c: v.cols, r: v.rows, pr: v.price, f: v.frame, img: photoFor(v) ?? null, d: v.isDefault }));
const specs = [
  ['Console', p.consoleSpec], ['Frame', p.frameMaterial ? `Material: ${p.frameMaterial}` : ''], ['Remote', p.remoteSpec],
].filter(([, t]) => t) as [string, string][];
// "Key: value" run-ons in the source are glued together; split on the known labels.
const rows = (t: string) => t.replace(/(Console Size|Peak Power|Flicker-Free|Dimming|Dimensions|Power Supply|Material|Wireless Protocol|Mounting|Operating Temp|Humidity Tolerance|Weight):/g, '\n$1:').split('\n').map(s => s.trim()).filter(Boolean).map(s => { const i = s.indexOf(':'); return [s.slice(0, i), s.slice(i + 1).trim()] as const; });
const isSky = p.kind !== 'accessory';
const title = `${p.title} ${p.kind === 'window' ? '' : p.kind === 'skylight' ? 'SUNROOOF' : ''}`.trim();
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: p.title, description: clean(p.description), image: p.images.slice(0, 4), brand: { '@type': 'Brand', name: 'SUNROOOF' }, offers: { '@type': 'AggregateOffer', priceCurrency: 'INR', lowPrice: p.from, offerCount: p.variants.length } };
---
<Base noindex tone="night" header="night" announce={isSky ? 'Experience sunlight like never before. Exclusive launch offer for first 100 customers.' : undefined} title={title} description={clean(p.description).slice(0, 155)} image={p.images[0]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="wrap pd" data-pd data-variants={JSON.stringify(variants)}>
    <div class="pd__gal">
      <div class="pd__main"><img id="pd-main" src={`${p.images[0]}?width=1100&format=pjpg`} srcset={`${p.images[0]}?width=700&format=pjpg 700w, ${p.images[0]}?width=1100&format=pjpg 1100w, ${p.images[0]}?width=1600&format=pjpg 1600w`} sizes="(min-width: 62rem) 52vw, 100vw" alt={`${p.title}${p.finish ? ', ' + p.finish + ' finish' : ''}`} width="1100" height="1100" fetchpriority="high" />{p.images.length > 1 && <><button type="button" class="pd__arr pd__arr--p" aria-label="Previous image" data-step="-1">‹</button><button type="button" class="pd__arr pd__arr--n" aria-label="Next image" data-step="1">›</button></>}</div>
      {p.images.length > 1 && (
        <ul class="pd__thumbs" aria-label="More images">
          {p.images.slice(0, 8).map((u, i) => <li><button type="button" data-thumb={u} aria-label={`Show image ${i + 1}`} aria-pressed={i === 0}><img src={`${u}?width=160&format=pjpg`} alt="" width="80" height="80" loading="lazy" /></button></li>)}
        </ul>
      )}
    </div>

    <div class="pd__buy">
      <p class="kicker">{isSky ? 'Sunlight in any room, the future of lighting' : col.title}</p>
      <h1>{p.title}</h1>
      {p.description && <p class="pd__lead">{clean(p.description)}</p>}
      {isSky && <div class="pd__pills"><a href="#pay-plan" data-open="pay-plan">How our pricing works?</a><a href="https://sunrooof.cloud/Catalogue/SUNROOOF%20Updated.pdf" target="_blank" rel="noopener">Download our catalogue</a></div>}
      <p class="pd__price num" aria-live="polite"><span id="pd-price">{inr(def.price)}</span>{p.booking > 0 && <small> / Book with {inr(p.booking)}</small>}</p>
      {sized.length > 1 && <p class="pd__note">Freight, installation, handling &amp; taxes calculated at checkout.{p.minBilling ? ' ' + clean(p.minBilling) : ''}<span hidden id="pd-size">{def.title.replace("X", "×")}</span></p>}
      {isSky && <p class="pd__emi"><span>Buy on EMI</span><span>Easy payments plan</span></p>}

      {sibs.length > 1 && (
        <fieldset class="pd__fin"><legend>Frame finish: <b>{p.finish}</b></legend>
          <div>{sibs.map(s => <a href={`/products/${s.handle}`} class="sw" style={`--c:${FINISH[s.finish!] ?? '#ccc'}`} aria-label={s.finish!} aria-current={s.handle === p.handle ? 'true' : undefined} title={s.finish!}></a>)}</div>
        </fieldset>
      )}

      {sized.length > 1 && (
        <fieldset class="pd__sizes"><legend>Choose Frame Grid Size (In Consoles):</legend>
          <div role="radiogroup">
            {sized.map(v => <label class="chip"><input type="radio" name="size" value={v.id} checked={v.id === def.id} /><span>{v.title.replace('X', '×')}</span></label>)}
          </div>
          <button type="button" class="pd__sc" data-sc>Size chart</button>
        </fieldset>
      )}

      {sized.length > 0 && (
        <dialog class="pd__plan" data-plan aria-label="Size chart">
          <button type="button" class="pd__x" aria-label="Close size chart" data-x>×</button>
          <svg id="pd-plan" viewBox="0 0 200 120" role="img" aria-label="Frame plan"></svg>
          <dl id="pd-dims">
            <div><dt>Frame width</dt><dd><span data-d="w">—</span> mm</dd></div>
            <div><dt>Frame length</dt><dd><span data-d="l">—</span> mm</dd></div>
            <div><dt>Frame depth</dt><dd><span data-d="d">—</span> mm</dd></div>
            <div><dt>Consoles</dt><dd><span data-d="n">—</span></dd></div>
          </dl>
        </dialog>
      )}

      {isSky && (
        <ul class="pd__pts">
          <li><img src={L('coverage.png', 60)} alt="" width="22" height="22" />SUNROOOF recommends 60–70% area coverage for optimal experience</li>
          <li><img src={L('rullaer.png', 60)} alt="" width="22" height="22" />We have a fixed console size: 1200 mm long × 400 mm wide</li>
          <li><img src={L('sequrity.png', 60)} alt="" width="22" height="22" />Hassle-free 3-year guarantee on the entire system (India &amp; UAE)</li>
        </ul>
      )}

      <div class="pd__accs">
        {isSky && (
          <details class="acc" id="pay-plan" open>
            <summary>Easy Payment Plan</summary>
            <p>SUNROOOF installation happens in 6 phases:</p>
            <ol class="stg">
              <li><b>Stage 1 (Booking):</b> The order is booked once you clear the 1st payment milestone; we arrange a site visit for accurate measurements.</li>
              <li><b>Stage 2 (Production):</b> We prepare shop drawings and seek your approval before production begins. Once we get the approval and the 2nd payment milestone is cleared, we manufacture the wooden frames for your site.</li>
              <li><b>Stage 3 (Wooden frames):</b> Once ready for dispatch, you clear the 3rd payment milestone and we dispatch and install the wooden frames at the site.</li>
              <li><b>Stage 4 (Your turn):</b> You pack the ceiling or wall with false ceiling or gypsum boards and do all your paint work and other dust-related work.</li>
              <li><b>Stage 5 (Light consoles):</b> Once the site is dust-free, you clear the 4th payment milestone and we dispatch and install the light consoles.</li>
              <li><b>Stage 6 (Handover):</b> After the light consoles are installed, we set up the automation and hand over the project.</li>
            </ol>
            <ol class="pay">
              <li><b>1st Split</b><span>Pay a flat {inr(p.booking || 50000)} to book</span></li>
              <li><b>2nd Split</b><span>50% of the balance, before production</span></li>
              <li><b>3rd Split</b><span>25% of the balance, at frame dispatch</span></li>
              <li><b>4th Split</b><span>25% of the balance, at light dispatch</span></li>
            </ol>
          </details>
        )}
        {p.guarantee && <details class="acc"><summary>Guarantee Info</summary><p>{clean(p.guarantee)}</p></details>}
        {specs.length > 0 && (
          <details class="acc" open={!isSky}>
            <summary>Technical Specification</summary>
            {specs.map(([k, t]) => <><h3 class="acc__k">{k}</h3><dl class="spec">{rows(t).map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl></>)}
          </details>
        )}
        {isSky && (
          <details class="acc">
            <summary>What if it Doesn't fit?</summary>
            {p.fit && <p>{clean(p.fit)}</p>}
            <form onsubmit="return false">
              <div class="calc">
                <label>Room length (m)<input id="rl" type="number" min="1" step="0.1" inputmode="decimal" value="4" /></label>
                <label>Room width (m)<input id="rw" type="number" min="1" step="0.1" inputmode="decimal" value="3" /></label>
              </div>
              <p id="calc-out" aria-live="polite"></p>
            </form>
            <p class="muted">SUNROOOF recommends 60–70% ceiling area coverage. Each console is 1200 × 400 mm (0.48 m²). A site visit confirms the final grid.</p>
          </details>
        )}
      </div>

      <div class="pd__cta">
        <a class="btn" id="pd-book" href="/pages/contact-us" data-lead>Customise your SUNROOOF</a>
        <a class="btn btn--ghost" href="/pages/contact-us" data-lead data-prefill="I have a big project.">I have a big project</a>
      </div>
      {isSky && <a class="pd__cat" href="https://sunrooof.cloud/Catalogue/SUNROOOF%20Updated.pdf" target="_blank" rel="noopener">Download the catalogue (PDF)</a>}
    </div>
  </section>

  <ProductStory related={related} sky={isSky} />
  <FaqBlock />
</Base>

<style is:global>
  .pd__crumbs { display: flex; flex-wrap: wrap; gap: var(--s-3); font-size: var(--t-small); padding-top: var(--s-5); color: var(--ink-3); }
  .pd__crumbs a { color: var(--ink-3); text-decoration: none; } .pd__crumbs a:hover { color: var(--ink); text-decoration: underline; }
  .pd__crumbs > *:not(:last-child)::after { content: '/'; margin-left: var(--s-3); color: var(--line); }
  .pd { display: grid; gap: var(--s-7); padding-block: var(--s-6) var(--s-9); align-items: start; }
  .pd__gal { display: grid; gap: var(--s-3); min-width: 0; }
  .pd__main { aspect-ratio: 1; background: var(--paper-3); border-radius: var(--r-1); overflow: hidden; }
  .pd__main img { width: 100%; height: 100%; object-fit: cover; transition: opacity var(--d-base) var(--ease-out); }
  .pd__main img.is-swap { opacity: 0; }
  .pd__thumbs { display: flex; gap: var(--s-2); overflow-x: auto; list-style: none; padding: 0; margin: 0; scrollbar-width: thin; }
  .pd__thumbs button { width: 4.5rem; height: 4.5rem; padding: 0; border: 2px solid transparent; border-radius: var(--r-1); background: var(--paper-3); cursor: pointer; overflow: hidden; flex: none; }
  .pd__thumbs button[aria-pressed=true] { border-color: var(--ink); } .pd__thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .pd__buy { display: grid; gap: var(--s-5); min-width: 0; }
  .pd__buy h1 { font: 300 clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem)/1.15 var(--font-display); }
  .pd__lead { color: var(--ink-2); max-width: 52ch; }
  .pd__price { font: 400 1.5rem/1 var(--font-display); color: var(--ink); } .pd__price small { font: var(--w-regular) var(--t-small)/1 var(--font-body); color: var(--ink-3); }
  .pd fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: var(--s-3); min-width: 0; }
  .pd legend { font-weight: var(--w-semi); font-size: var(--t-small); padding: 0; margin-bottom: var(--s-3); }
  .pd__fin > div { display: flex; gap: var(--s-3); }
  .sw { width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgb(0 0 0 / .25); outline: 2px solid transparent; outline-offset: 3px; transition: outline-color var(--d-base); }
  .sw:hover { outline-color: var(--line); } .sw[aria-current] { outline-color: var(--ink); }
  .pd__sizes [role=radiogroup] { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chip { position: relative; } .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; justify-content: center; min-width: 3.5rem; min-height: 2.75rem; padding: 0 var(--s-4); border: 1px solid var(--line); border-radius: var(--r-pill); font-weight: var(--w-semi); font-size: var(--t-small); transition: background var(--d-base), color var(--d-base), border-color var(--d-base); }
  .chip:hover span { border-color: var(--ink); }
  .chip input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 2px solid var(--brass-ink); outline-offset: 2px; }
  .pd__plan { border: 0; padding: var(--s-6); background: var(--paper-2); color: var(--ink); border-radius: var(--r-1); width: min(32rem, 92vw); position: fixed; inset: 0; margin: auto; height: fit-content; } .pd__plan[open] { display: grid; gap: var(--s-5); } .pd__plan::backdrop { background: rgb(0 0 0 / .6); }
  .pd__x { justify-self: end; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; color: inherit; font-size: 1.75rem; cursor: pointer; }
  .pd__sizes { position: relative; } .pd__sc { position: absolute; right: 0; top: 0; min-height: 2.75rem; padding: 0 var(--s-4); border: 1px solid var(--line); border-radius: var(--r-pill); background: transparent; color: inherit; font: inherit; font-size: var(--t-small); cursor: pointer; } .pd__sc:hover { border-color: var(--ink); }
  .pd__pills { display: flex; flex-wrap: wrap; gap: var(--s-2); } .pd__pills a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--s-4); border-radius: var(--r-pill); background: var(--ink); color: var(--paper); font-size: var(--t-small); text-decoration: none; font-weight: var(--w-semi); } .pd__pills a:hover { background: var(--sun); color: #111; }
  .pd__note { margin: calc(var(--s-4) * -1) 0 0; color: var(--ink-3); font-size: var(--t-small); max-width: 52ch; }
  .pd__emi { display: flex; flex-wrap: wrap; gap: var(--s-2); margin: 0; font-size: var(--t-small); } .pd__emi span { padding: .375rem .75rem; border: 1px solid var(--line); border-radius: var(--r-pill); color: var(--ink-2); }
  .pd__pts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); font-size: var(--t-small); } .pd__pts li { display: flex; gap: var(--s-3); align-items: center; color: var(--ink-2); } .pd__pts img { flex: none; width: 1.375rem; height: 1.375rem; }
  .stg { margin: 0 0 var(--s-4); padding: 0; list-style: none; display: grid; gap: var(--s-3); font-size: var(--t-small); color: var(--ink-2); } .stg b { color: var(--sun); font-weight: var(--w-semi); }
  .pd__main { position: relative; } .pd__arr { position: absolute; top: 50%; translate: 0 -50%; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 0; background: #fff; color: #111; font-size: 1.5rem; line-height: 1; cursor: pointer; box-shadow: 0 2px 10px rgb(0 0 0 / .25); } .pd__arr--p { left: var(--s-3); } .pd__arr--n { right: var(--s-3); } .pd__arr:hover { background: var(--sun); }
  #pd-plan { width: 100%; height: auto; max-height: 11rem; }
  #pd-plan rect.fr { fill: none; stroke: var(--ink); stroke-width: 2; } #pd-plan rect.cell { fill: var(--sun); fill-opacity: .55; stroke: var(--brass-ink); stroke-width: 1; transition: all var(--d-base) var(--ease-out); }
  #pd-dims { display: grid; gap: var(--s-2); margin: 0; font-size: var(--t-small); } #pd-dims div { display: flex; justify-content: space-between; gap: var(--s-3); border-bottom: 1px solid var(--line); padding-bottom: var(--s-1); }
  #pd-dims dt { color: var(--ink-3); } #pd-dims dd { margin: 0; font-weight: var(--w-semi); white-space: nowrap; } #pd-dims dt { min-width: 0; }
  .pd__calc { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: var(--s-3); }
  .pd__calc summary, .acc summary { cursor: pointer; font-weight: var(--w-semi); min-height: 2.75rem; display: flex; align-items: center; }
  .calc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); margin-block: var(--s-3); }
  .calc label { display: grid; gap: var(--s-1); font-size: var(--t-small); font-weight: var(--w-semi); }
  .calc input { width: 100%; min-width: 0; min-height: 2.75rem; padding: 0 var(--s-3); border: 1px solid var(--line); background: transparent; border-radius: var(--r-1); font: inherit; }
  .calc input:focus-visible { outline: 2px solid var(--brass-ink); outline-offset: 1px; }
  #calc-out { color: var(--ink); font-weight: var(--w-semi); }
  .pd__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .pd__accs { display: grid; } .pd__cat { font-size: var(--t-small); color: var(--ink-3); text-decoration: underline; justify-self: start; }
  .acc__k { font: 600 var(--t-small)/1 var(--font-body); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); margin: var(--s-3) 0 var(--s-2); }
  .pay { list-style: none; margin: 0 0 var(--s-4); padding: 0; display: grid; gap: var(--s-2); grid-template-columns: 1fr 1fr; } .pay li { display: grid; gap: .25rem; padding: var(--s-3); border: 1px solid var(--line); font-size: var(--t-small); } .pay b { color: var(--sun); text-transform: uppercase; font-size: .75rem; }
  .pd__info { display: grid; gap: var(--s-8); padding-bottom: var(--section); }
  .pd__info h2, .pd__rel h2 { font-size: var(--t-h3); margin-bottom: var(--s-5); }
  .acc { border-top: 1px solid var(--line); } .acc:last-child { border-bottom: 1px solid var(--line); } .acc > p { padding-bottom: var(--s-4); max-width: 60ch; }
  .spec { display: grid; margin: 0 0 var(--s-4); } .spec div { display: grid; grid-template-columns: minmax(7rem, 1fr) 2fr; gap: var(--s-4); padding: var(--s-2) 0; font-size: var(--t-small); }
  .spec dt { color: var(--ink-3); } .spec dd { margin: 0; }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 0 0 var(--s-5); display: grid; gap: var(--s-4); }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--s-3); color: var(--ink-2); }
  .steps li::before { content: counter(s, decimal-leading-zero); font: 400 1.5rem/1 var(--font-display); color: var(--brass-ink); }
  .steps b { color: var(--ink); }
  .pd__rel { padding-bottom: var(--section); }
  .pd__rel ul { display: grid; gap: var(--s-6); list-style: none; padding: 0; margin: 0; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .pd__rel a { display: grid; gap: var(--s-2); text-decoration: none; } .pd__rel img { aspect-ratio: 1; width: 100%; object-fit: cover; border-radius: var(--r-1); background: var(--paper-3); }
  .pd__rel a:hover b { color: var(--brass-ink); }
  @media (min-width: 62rem) {
    .pd { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--s-9); }
    .pd__gal { position: sticky; top: 5.5rem; }
    .pd__info { grid-template-columns: 1fr 1fr; gap: var(--s-9); }
  }
</style>

<script>
  type V = { id: number; t: string; c: number | null; r: number | null; pr: number; f: { w: number; l: number; d: number } | null; img: string | null; d: boolean };
  const root = document.querySelector<HTMLElement>('[data-pd]');
  if (root) {
    const vs: V[] = JSON.parse(root.dataset.variants!);
    const inr = (n: number) => '₹ ' + new Intl.NumberFormat('en-IN').format(n);
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s);
    const main = $<HTMLImageElement>('#pd-main')!;
    const setImg = (u: string) => {
      const cur = main.src.split('?')[0]; if (u === cur) return;
      main.classList.add('is-swap');
      setTimeout(() => { main.src = `${u}?width=1100&format=pjpg`; main.srcset = `${u}?width=700&format=pjpg 700w, ${u}?width=1100&format=pjpg 1100w, ${u}?width=1600&format=pjpg 1600w`; main.classList.remove('is-swap'); }, 160);
    };
    root.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach(b => b.addEventListener('click', () => {
      root.querySelectorAll('[data-thumb]').forEach(x => x.setAttribute('aria-pressed', String(x === b))); setImg(b.dataset.thumb!);
    }));
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>("[data-thumb]")];
    root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach(b => b.addEventListener("click", () => {
      const i = thumbs.findIndex(t => t.getAttribute("aria-pressed") === "true"); const t = thumbs[(i + Number(b.dataset.step) + thumbs.length) % thumbs.length]; t.click(); t.scrollIntoView({ block: "nearest", inline: "nearest" });
    }));
    const dlg = $<HTMLDialogElement>("[data-plan]");
    $("[data-sc]")?.addEventListener("click", () => dlg?.showModal()); $("[data-x]")?.addEventListener("click", () => dlg?.close());
    dlg?.addEventListener("click", e => { if (e.target === dlg) dlg.close(); });
    document.querySelector("[data-open]")?.addEventListener("click", e => { e.preventDefault(); const d = document.getElementById("pay-plan") as HTMLDetailsElement; d.open = true; d.scrollIntoView({ behavior: "smooth", block: "start" }); });
    const plan = $<SVGElement>('#pd-plan');
    const draw = (v: V) => {
      if (!plan || !v.c || !v.r || !v.f) return;
      // grid is "cols × rows": frame width ↔ cols, frame length ↔ rows. Scale to fit 200×120.
      const W = v.f.w, L = v.f.l, s = Math.min(176 / L, 104 / W), fw = L * s, fh = W * s, x0 = (200 - fw) / 2, y0 = (120 - fh) / 2;
      const cw = fw / v.r, ch = fh / v.c, pad = 2;
      let h = `<rect class="fr" x="${x0}" y="${y0}" width="${fw}" height="${fh}"/>`;
      for (let i = 0; i < v.r; i++) for (let j = 0; j < v.c; j++) h += `<rect class="cell" x="${x0 + i * cw + pad}" y="${y0 + j * ch + pad}" width="${cw - pad * 2}" height="${ch - pad * 2}"/>`;
      plan.innerHTML = h;
      plan.setAttribute('aria-label', `Frame plan: ${v.c} by ${v.r} consoles, ${v.f.w} by ${v.f.l} millimetres`);
    };
    const set = (v: V, swap = true) => {
      $('#pd-price')!.textContent = inr(v.pr);
      const sz = $('#pd-size'); if (sz) sz.textContent = v.t.replace("X", "×");
      if (v.f) { ($('[data-d=w]') as HTMLElement).textContent = v.f.w.toLocaleString('en-IN'); ($('[data-d=l]') as HTMLElement).textContent = v.f.l.toLocaleString('en-IN'); ($('[data-d=d]') as HTMLElement).textContent = String(v.f.d); ($('[data-d=n]') as HTMLElement).textContent = `${v.c! * v.r!} (${v.c} × ${v.r})`; }
      draw(v); if (swap && v.img) setImg(v.img);
      const q = new URLSearchParams({ product: $('h1')!.textContent!, size: v.t }); $<HTMLAnchorElement>('#pd-book')!.dataset.prefill = `Interested in: ${q.get('product')}, ${v.t.replace('X', '×')} frame.`;
    };
    const pick = () => { const id = Number($<HTMLInputElement>('input[name=size]:checked')?.value); return vs.find(v => v.id === id) ?? vs.find(v => v.d) ?? vs[0]; };
    root.querySelectorAll('input[name=size]').forEach(i => i.addEventListener('change', () => set(pick())));
    set(pick(), false); // hero stays until the user picks a size
    const calc = () => {
      const l = parseFloat((document.getElementById('rl') as HTMLInputElement)?.value), w = parseFloat((document.getElementById('rw') as HTMLInputElement)?.value), out = document.getElementById('calc-out');
      if (!out) return; if (!(l > 0 && w > 0)) { out.textContent = ''; return; }
      const a = l * w, lo = Math.ceil(a * 0.6 / 0.48), hi = Math.floor(a * 0.7 / 0.48);
      out.textContent = `${a.toFixed(1)} m² room: about ${lo}${hi > lo ? '–' + hi : ''} consoles for 60–70% coverage.`;
    };
    ['rl', 'rw'].forEach(id => document.getElementById(id)?.addEventListener('input', calc)); calc();
  }
</script>
